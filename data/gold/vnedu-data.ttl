    schema:image <https://upload.wikimedia.org/wikipedia/commons/a/a2/%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Ph%C3%BA_Xu%C3%A2n.jpg> ;
    schema:logo <https://upload.wikimedia.org/wikipedia/commons/8/80/Logo_PXU_%C4%91%E1%BB%8F_-_navy.png> ;

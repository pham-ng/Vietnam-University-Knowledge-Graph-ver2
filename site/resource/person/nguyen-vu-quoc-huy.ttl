@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix person: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/person/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix university: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/university/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .

person:nguyen-vu-quoc-huy a foaf:Person,
        vnedu:InstitutionLeader,
        vnedu:Person,
        schema:Person ;
    rdfs:label "Nguyễn Vũ Quốc Huy"@vi ;
    foaf:name "Nguyễn Vũ Quốc Huy" ;
    vnedu:honorific "GS TS" ;
    vnedu:leads university:dai-hoc-hue,
        university:truong-dai-hoc-ngoai-ngu-dai-hoc-hue,
        university:truong-dai-hoc-y-duoc-dai-hoc-hue .


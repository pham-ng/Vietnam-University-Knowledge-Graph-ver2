      "dbo:abstract": {
        "@language": "vi",
        "@value": "Trường Đại học Sư phạm Thể dục Thể thao Thành phố Hồ Chí Minh là trường đại học nằm tại Thành phố Hồ Chí Minh, được thành lập từ những năm 1976. Hiện nay trường đào tạo giáo viên thể dục cho miền nam Việt Nam"
      },

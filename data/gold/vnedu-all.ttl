        <https://ror.org/02wqs8977> ;
    geo:lat 12.2151 ;
    geo:long 109.207 ;
    skos:notation "HQH" ;
    skos:prefLabel "Học viện Hải quân"@vi ;
    prov:wasDerivedFrom wd:Q7928533,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75022945> ;

    schema:foundingDate "2000-11-06T00:00:00"^^xsd:dateTime ;
    schema:image <https://upload.wikimedia.org/wikipedia/commons/f/f5/To%C3%A0_nh%C3%A0_h%E1%BB%8Dc_t%E1%BA%ADp_B1_v%C3%A0_to%C3%A0_nh%C3%A0_th%C6%B0_vi%E1%BB%87n_B2_UEL.jpg> ;
    schema:logo <https://upload.wikimedia.org/wikipedia/commons/8/88/Logo_Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_kinh_t%E1%BA%BF_-_Lu%E1%BA%ADt_%28UEL%29%2C_%C4%90HQG-HCM%2C_220px.png> ;

      "dbo:abstract": {
        "@language": "vi",
        "@value": "Trường Đại học Thương mại (tiếng Anh: Thuongmai University hoặc Vietnam University of Commerce, tên viết tắt: TMU) là Trường Đại học công lập của Việt Nam về khối ngành Thương mại, trực thuộc Bộ Giáo dục và Đào tạo, hoạt động theo cơ chế tự chủ."
      },

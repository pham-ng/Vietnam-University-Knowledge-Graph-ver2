province:phu-tho a vnedu:AdministrativeUnit,
        vnedu:Province,
        schema:AdministrativeArea ;
    rdfs:label "Phú Thọ"@en,
        "Phú Thọ"@vi ;
    owl:sameAs dbr:Phú_Thọ_province,
        wd:Q36610,
        <https://sws.geonames.org/1905577/> ;
    geo:lat 21.333333333 ;
    geo:long 105.166666666 ;
    prov:wasDerivedFrom wd:Q36610 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Ph%C3%BA_Th%E1%BB%8D_province>,
        <https://vi.wikipedia.org/wiki/Ph%C3%BA_Th%E1%BB%8D> ;
    vnedu:area 9361.0 ;
    vnedu:mergedFrom province:hoa-binh,
        province:vinh-phuc ;
    vnedu:partOf country:viet-nam,
        region:bac-bo ;
    vnedu:population "3663700"^^xsd:nonNegativeInteger .


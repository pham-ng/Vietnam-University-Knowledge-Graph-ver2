  "HigherEducationInstitution" [label="HigherEducationInstitution", shape=box, style="rounded,filled", fillcolor="#E3F4EC", color="#1BAF7A", penwidth=1.6];
  "Major" [label="Major", shape=box, style="rounded,filled", fillcolor="#E2F1EE", color="#0F6E64", penwidth=1.6];
  "Organization" [label="Organization", shape=box, style="rounded,filled", fillcolor="#E3F4EC", color="#1BAF7A", penwidth=1.6];
  "OwnershipType" [label="OwnershipType", shape=box, style="rounded,filled", fillcolor="#E4EEFB", color="#2A78D6", penwidth=1.6];
  "Person" [label="Person", shape=box, style="rounded,filled", fillcolor="#FDEBE2", color="#EB6834", penwidth=1.6];
  "Province" [label="Province", shape=box, style="rounded,filled", fillcolor="#F8EEDC", color="#9A5B00", penwidth=1.6];
  "StateAgency" [label="StateAgency", shape=box, style="rounded,filled", fillcolor="#E4EEFB", color="#2A78D6", penwidth=1.6];
  "University" [label="University", shape=box, style="rounded,filled", fillcolor="#E3F4EC", color="#1BAF7A", penwidth=1.6];
  "Person" -> "EducationalOrganization" [label="alumnusOf", color="#3B3B3B", fontcolor="#1F1F1F"];
  "Person" -> "AdministrativeUnit" [label="bornIn", color="#3B3B3B", fontcolor="#1F1F1F"];
  "Branch" -> "HigherEducationInstitution" [label="branchOf", color="#3B3B3B", fontcolor="#1F1F1F"];

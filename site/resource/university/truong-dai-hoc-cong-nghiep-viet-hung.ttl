    rdfs:label "Viet-Hung Industrial University"@en,
        "Trường Đại học Công nghiệp Việt – Hung"@vi ;
    dbo:abstract "Trường Đại học Công nghiệp Việt – Hung (tiếng Anh: Vietnam–Hungary Industrial University – VIU) là trường đại học công lập trực thuộc Bộ Công Thương, chịu sự quản lý của Bộ Giáo dục và Đào tạo."@vi ;
    owl:sameAs wd:Q16480995,
        <https://ror.org/02sndnx77> ;
    skos:altLabel "Đại học Việt Hung" ;
    skos:prefLabel "Trường Đại học Công nghiệp Việt – Hung"@vi ;
    prov:wasDerivedFrom wd:Q16480995,
        <https://vi.wikipedia.org/w/index.php?oldid=75101686> ;

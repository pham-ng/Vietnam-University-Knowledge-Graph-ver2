province:hai-phong a vnedu:AdministrativeUnit,
        vnedu:CentrallyGovernedCity,
        vnedu:Province,
        schema:AdministrativeArea ;
    rdfs:label "Haiphong"@en,
        "Hải Phòng"@vi ;
    owl:sameAs dbr:Haiphong,
        wd:Q72818,
        <https://sws.geonames.org/1581297/> ;
    geo:lat 20.8 ;
    geo:long 106.666666666 ;
    prov:wasDerivedFrom wd:Q72818 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Haiphong>,
        <https://vi.wikipedia.org/wiki/H%E1%BA%A3i_Ph%C3%B2ng> ;
    vnedu:area 3195.0 ;
    vnedu:mergedFrom province:hai-duong ;
    vnedu:partOf country:viet-nam,
        region:bac-bo ;
    vnedu:population "2124500"^^xsd:nonNegativeInteger .


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/schemas/silver.schema.json",
  "title": "VN-Edu — hợp đồng dữ liệu tầng SILVER",
  "description": "Mỗi bản ghi silver phải thoả schema tương ứng trước khi được chuyển sang RDF (tầng gold).",
  "$defs": {
    "qid": { "type": "string", "pattern": "^Q[1-9][0-9]*$" },
    "qidOrEmpty": { "type": "string", "pattern": "^(Q[1-9][0-9]*)?$" },
    "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
    "count": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
    "nonEmpty": { "type": "string", "minLength": 1 },

    "institution": {
      "type": "object",
      "required": ["key", "qid", "name_vi", "kind", "admission_codes", "short_names", "former_names",
                   "member_of", "branch_of", "governed_by", "owned_by", "leaders"],
      "properties": {
        "key": { "type": "string", "pattern": "^(Q[1-9][0-9]*|vi:.+)$" },
        "qid": { "$ref": "#/$defs/qidOrEmpty" },
        "same_qids": { "type": "array", "items": { "$ref": "#/$defs/qid" }, "uniqueItems": true },
        "name_vi": { "$ref": "#/$defs/nonEmpty" },
        "name_en": { "type": "string" },
        "kind": { "enum": ["University", "UniversitySchool", "Academy", "OfficerSchool", "NationalUniversity",
                           "RegionalUniversity", "HigherEducationInstitution", "Branch", "VocationalCollege",
                           "Seminary", "Institute", "AcademicUnit"] },
        "viwiki": { "type": "string" },
        "viwiki_revid": { "type": ["integer", "null"], "minimum": 1 },
        "founding_year": { "$ref": "#/$defs/year" },
        "dissolution_year": { "$ref": "#/$defs/year" },
        "ownership": { "enum": ["public", "private"] },
        "students": { "$ref": "#/$defs/count" },
        "undergraduates": { "$ref": "#/$defs/count" },
        "postgraduates": { "$ref": "#/$defs/count" },
        "academic_staff": { "$ref": "#/$defs/count" },
        "admission_codes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{3}$" }, "uniqueItems": true },
        "short_names": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 15 } },
        "former_names": { "type": "array", "items": { "type": "string", "minLength": 6 } },
        "ror": { "type": "array", "items": { "type": "string", "pattern": "^0[a-z0-9]{6}[0-9]{2}$" } },
        "website": { "type": ["string", "null"], "pattern": "^https?://[^\\s]+\\.[^\\s]+" },
        "lat": { "type": "number", "minimum": 8.0, "maximum": 23.5 },
        "long": { "type": "number", "minimum": 102.0, "maximum": 110.0 },
        "province": { "anyOf": [{ "$ref": "#/$defs/qid" }, { "type": "null" }] },
        "member_of": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "branch_of": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "governed_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "owned_by": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "leaders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "name", "source"],
            "properties": {
              "role": { "enum": ["rector", "director"] },
              "qid": { "$ref": "#/$defs/qidOrEmpty" },
              "name": { "type": "string", "pattern": "^\\S+(\\s\\S+){1,5}$" },
              "source": { "enum": ["wikidata", "viwiki"] }
            }
          }
        }
      }
    },

    "governing_body": {
      "type": "object",
      "required": ["key", "name_vi", "kind", "subordinate_to"],
      "properties": {
        "qid": { "$ref": "#/$defs/qidOrEmpty" },
        "name_vi": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["Ministry", "ProvincialPeoplesCommittee", "GoverningBody", "Company"] },
        "subordinate_to": { "type": "array", "items": { "type": "string" } }
      }
    },

    "person": {
      "type": "object",
      "required": ["key", "name_vi", "name_en", "alumnus_of", "leads"],
      "anyOf": [{ "properties": { "name_vi": { "minLength": 1 } } }, { "properties": { "name_en": { "minLength": 1 } } }],
      "properties": {
        "qid": { "$ref": "#/$defs/qidOrEmpty" },
        "birth_date": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "alumnus_of": { "type": "array", "items": { "type": "string" } },
        "leads": { "type": "array", "items": { "type": "object", "required": ["org", "role"] } }
      }
    },

    "province": {
      "type": "object",
      "required": ["qid", "name_vi", "status"],
      "properties": {
        "qid": { "$ref": "#/$defs/qid" },
        "status": { "enum": ["current", "former"] },
        "population": { "type": ["integer", "null"], "minimum": 1000 },
        "area": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "region": { "enum": ["Bắc Bộ", "Trung Bộ", "Nam Bộ", null] },
        "merged_into": { "anyOf": [{ "$ref": "#/$defs/qid" }, { "type": "null" }] }
      },
      "if": { "properties": { "status": { "const": "current" } } },
      "then": { "required": ["region"], "properties": { "region": { "type": "string" } } },
      "else": { "required": ["merged_into"], "properties": { "merged_into": { "$ref": "#/$defs/qid" } } }
    }
  }
}

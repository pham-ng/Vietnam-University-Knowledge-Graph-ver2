  "vnedu:history": {
    "@language": "vi",
    "@value": "Tiền thân của trường Đại học Quy Nhơn là trường Đại học Sư phạm Quy Nhơn được thành lập ngày 21 tháng 12 năm 1977 với cơ sở vật chất tiếp quản từ trường Sư phạm Quy Nhơn của chính quyền cũ trước đó. Ngày 30 tháng 10 năm 2003, trường Đại học Sư phạm Quy Nhơn được đổi tên thành trường Đại học Quy Nhơn."
  },

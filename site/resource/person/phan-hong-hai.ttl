@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix person: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/person/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix university: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/university/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .

person:phan-hong-hai a foaf:Person,
        vnedu:InstitutionLeader,
        vnedu:Person,
        schema:Person ;
    rdfs:label "Phan Hồng Hải"@vi ;
    foaf:name "Phan Hồng Hải" ;
    vnedu:honorific "TS" ;
    vnedu:leads university:truong-dai-hoc-cong-nghiep-thanh-pho-ho-chi-minh .


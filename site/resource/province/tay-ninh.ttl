        wd:Q36608,
        <https://sws.geonames.org/1566557/> ;
    geo:lat 11.333333333 ;
    geo:long 106.166666666 ;
    prov:wasDerivedFrom wd:Q36608 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/T%C3%A2y_Ninh_province>,
        <https://vi.wikipedia.org/wiki/T%C3%A2y_Ninh> ;
    vnedu:area 8536.0 ;
    vnedu:mergedFrom province:long-an ;
    vnedu:partOf country:viet-nam,
        region:nam-bo ;
    vnedu:population "2959000"^^xsd:nonNegativeInteger .


@prefix country: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/country/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix field: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/field/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix major: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/major/> .
@prefix organization: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/organization/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix person: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/person/> .
@prefix program: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/program/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix province: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/province/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix region: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/region/> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix university: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/university/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dbo:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract"@en,
        "giới thiệu chung"@vi ;
    rdfs:comment "Đoạn mở đầu bài Wikipedia tiếng Việt (CC BY-SA 4.0) — cùng thuộc tính DBpedia dùng cho tóm tắt."@vi .

dbo:affiliation a owl:ObjectProperty ;
    rdfs:label "affiliation"@en,
        "liên kết, đối tác"@vi ;
    rdfs:comment "Đối tác / liên kết học thuật. Đích là URI Wikidata của tổ chức đối tác (tái sử dụng, không tạo URI mới)."@vi .

dct:created a owl:AnnotationProperty .

dct:creator a owl:AnnotationProperty .

dct:description a owl:AnnotationProperty .

dct:license a owl:AnnotationProperty .

dct:modified a owl:AnnotationProperty .

dct:source a owl:AnnotationProperty .

dct:title a owl:AnnotationProperty .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en,
        "tên khác"@vi .

<https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology> a owl:Ontology ;
    dct:created "2026-10-05T00:00:00"^^xsd:dateTime ;
    dct:creator "VN-Edu LOD project" ;
    dct:description """Mô tả các cơ sở giáo dục đại học Việt Nam (đại học, trường đại học, học viện theo
Luật Giáo dục đại học 2012, sửa đổi 2018), cơ quan chủ quản, lãnh đạo, cựu sinh viên, đơn vị hành chính
(gồm cả sắp xếp tỉnh năm 2025), ngành đào tạo theo Thông tư 09/2022/TT-BGDĐT."""@vi ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:modified "2026-10-08T00:00:00"^^xsd:dateTime ;
    dct:source <https://vi.wikipedia.org/>,
        <https://www.wikidata.org/> ;
    dct:title "VN-Edu Ontology"@en,
        "Ontology Giáo dục đại học Việt Nam"@vi ;
    vann:preferredNamespacePrefix "vnedu" ;
    vann:preferredNamespaceUri "https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#" ;
    rdfs:comment "Rule-based OWL materialization using owlrl; formal OWL 2 RL profile conformance verified by the OWL API OWL2RLProfile gate (zero violations on release 2.2)."@en ;
    owl:priorVersion <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology/2.1> ;
    owl:versionIRI <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology/2.2> ;
    owl:versionInfo "2.2 - evidence-qualified temporal observations and conservative alignments" .

vnedu:address a owl:DatatypeProperty ;
    rdfs:label "address"@en,
        "địa chỉ"@vi ;
    rdfs:domain vnedu:Organization ;
    rdfs:range xsd:string .

vnedu:birthDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "birth date"@en,
        "ngày sinh"@vi ;
    rdfs:domain vnedu:Person ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dbo:birthDate,
        schema:birthDate .

vnedu:birthPlace a owl:ObjectProperty ;
    rdfs:label "birth place"@en,
        "nơi sinh"@vi ;
    rdfs:comment "Địa danh nơi sinh — dùng thẳng URI Wikidata của địa danh (tái sử dụng)."@vi ;
    rdfs:domain vnedu:Person ;
    rdfs:subPropertyOf dbo:birthPlace,
        schema:birthPlace .

vnedu:campus a owl:DatatypeProperty ;
    rdfs:label "campus"@en,
        "khuôn viên"@vi ;
    rdfs:comment "Diện tích / mô tả khuôn viên đúng như ghi ở nguồn (đơn vị không thống nhất nên giữ dạng văn bản)."@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dbo:campus .

vnedu:code a owl:DatatypeProperty ;
    rdfs:label "code"@en,
        "mã ngành / mã lĩnh vực"@vi ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf skos:notation .

vnedu:degreeLevel a owl:DatatypeProperty ;
    rdfs:label "degree level"@en,
        "trình độ đào tạo"@vi ;
    rdfs:domain vnedu:AcademicProgram ;
    rdfs:range rdfs:Literal .

vnedu:foundingYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "founding year"@en,
        "năm thành lập"@vi ;
    rdfs:comment "Earliest reported foundation year selected by the integration policy; it may refer to a predecessor and is not necessarily the legal establishment year."@en ;
    rdfs:domain vnedu:Organization ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf dbo:foundingYear .

vnedu:funding a owl:DatatypeProperty ;
    rdfs:label "funding / endowment"@en,
        "tài trợ, ngân sách, vốn đầu tư"@vi ;
    rdfs:comment "Giá trị đúng như ghi ở nguồn (kèm đơn vị tiền tệ, có thể kèm năm)."@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range xsd:string .

vnedu:history a owl:DatatypeProperty ;
    rdfs:label "history"@en,
        "lịch sử hình thành"@vi ;
    rdfs:comment "Tóm tắt mục Lịch sử của bài Wikipedia tiếng Việt (CC BY-SA 4.0); bản sửa đổi gốc ghi ở prov:wasDerivedFrom."@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range rdfs:Literal .

vnedu:honorific a owl:DatatypeProperty ;
    rdfs:label "academic title / rank"@en,
        "học hàm, học vị, quân hàm"@vi ;
    rdfs:domain vnedu:Person ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:honorificPrefix .

vnedu:inField a owl:ObjectProperty ;
    rdfs:label "in field"@en,
        "thuộc lĩnh vực"@vi ;
    rdfs:domain vnedu:Major ;
    rdfs:range vnedu:FieldOfStudy ;
    rdfs:subPropertyOf skos:broader .

vnedu:measurementUnit a owl:DatatypeProperty ;
    rdfs:label "measurement unit"@en ;
    rdfs:domain vnedu:MeasurementObservation ;
    rdfs:range xsd:string .

vnedu:motto a owl:DatatypeProperty ;
    rdfs:label "motto"@en,
        "khẩu hiệu"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dbo:motto .

vnedu:nationality a owl:ObjectProperty ;
    rdfs:label "nationality"@en,
        "quốc tịch"@vi ;
    rdfs:comment "Quốc tịch: country:viet-nam của dataset, hoặc URI Wikidata của quốc gia khác."@vi ;
    rdfs:domain vnedu:Person ;
    rdfs:range vnedu:Country ;
    rdfs:subPropertyOf dbo:nationality,
        schema:nationality .

vnedu:predecessor a owl:ObjectProperty ;
    rdfs:label "predecessor"@en,
        "tiền thân"@vi ;
    rdfs:comment "Tổ chức mà cơ sở này kế thừa (đổi tên, nâng cấp, tách, sáp nhập). Nguồn: Wikidata P1365 và trường \"tiền thân\" của infobox. Đích có thể là URI của dataset hoặc URI Wikidata (tái sử dụng)."@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:Organization ;
    rdfs:subPropertyOf dbo:predecessor ;
    owl:inverseOf vnedu:successor .

vnedu:referenceYear a owl:DatatypeProperty ;
    rdfs:label "source-reported measurement year"@en ;
    rdfs:domain vnedu:SourceObservation ;
    rdfs:range xsd:integer .

vnedu:reportedFoundingDate a owl:DatatypeProperty ;
    rdfs:label "conflicting source-reported foundation date"@en,
        "ngày thành lập khác được nguồn ghi nhận"@vi ;
    rdfs:comment "Infobox date whose year differs from the selected foundingYear. Retained for review, without asserting schema:foundingDate."@en ;
    rdfs:domain vnedu:Organization ;
    rdfs:range xsd:dateTime .

vnedu:snapshotDigest a owl:DatatypeProperty ;
    rdfs:label "digest of the supporting Silver snapshot"@en ;
    rdfs:domain vnedu:SourceObservation ;
    rdfs:range xsd:string .

vnedu:stateManagedBy a owl:ObjectProperty ;
    rdfs:label "under state management of"@en,
        "chịu quản lý nhà nước của"@vi ;
    rdfs:comment "Quản lý nhà nước về giáo dục (VD: Bộ GD&ĐT đối với trường tư thục) — KHÁC cơ quan chủ quản (vnedu:governedBy), vì trường tư không có cơ quan chủ quản nhà nước."@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:GoverningBody .

vnedu:temporalStatus a owl:DatatypeProperty ;
    rdfs:label "temporal evidence status"@en ;
    rdfs:domain vnedu:SourceObservation ;
    rdfs:range xsd:string .

vnedu:trainsMajor a owl:ObjectProperty ;
    rdfs:label "trains major"@en,
        "đào tạo ngành"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:Major ;
    owl:propertyChainAxiom ( vnedu:offersProgram vnedu:ofMajor ) .

vnedu:validFrom a owl:DatatypeProperty ;
    rdfs:label "known start of validity"@en ;
    rdfs:domain vnedu:SourceObservation ;
    rdfs:range xsd:dateTime .

vnedu:validThrough a owl:DatatypeProperty ;
    rdfs:label "known inclusive end of validity"@en ;
    rdfs:domain vnedu:SourceObservation ;
    rdfs:range xsd:dateTime .


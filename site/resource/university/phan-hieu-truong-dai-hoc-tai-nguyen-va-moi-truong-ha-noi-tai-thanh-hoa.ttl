    rdfs:label "Branch of Hanoi University of Natural Resources and Environment in Thanh Hoa"@en,
        "Phân hiệu Trường Đại học Tài nguyên và Môi trường Hà Nội tại Thanh Hóa"@vi ;
    dbo:abstract "Phân hiệu Trường Đại học Tài nguyên và Môi trường Hà Nội tại Thanh Hóa trước đây là Trường Cao đẳng Tài nguyên và Môi trường Miền Trung trực thuộc Bộ Tài nguyên và Môi trường và là phân hiệu của Trường Đại học Tài nguyên và Môi trường Hà Nội. Phân hiệu được đặt tại phường Ba Đình, thị xã Bỉm Sơn, tỉnh Thanh Hóa."@vi ;
    owl:sameAs wd:Q97964293 ;
    skos:prefLabel "Phân hiệu Trường Đại học Tài nguyên và Môi trường Hà Nội tại Thanh Hóa"@vi ;

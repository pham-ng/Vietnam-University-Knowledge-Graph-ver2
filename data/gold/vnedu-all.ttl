        vnedu:Organization,
        vnedu:PublicInstitution,
        vnedu:University,
        schema:CollegeOrUniversity,
        schema:EducationalOrganization,
        schema:Organization ;
    rdfs:label "Hanoi University of Industry"@en,
        "Đại học Công nghiệp Hà Nội"@vi ;
    dbo:abbreviation "HaUI" ;
    dbo:abstract "Đại học Công nghiệp Hà Nội (tiếng Anh: Hanoi University of Industry, viết tắt: HaUI) là một đại học công lập, đa ngành, đa nghề, định hướng ứng dụng và thực hành trực thuộc Bộ Công thương, với thế mạnh truyền thống trong lĩnh vực kỹ thuật và công nghệ. Trường được nâng cấp lên đại học năm 2005 trên cơ sở Trường Cao đẳng Công nghiệp Hà Nội. Tiền thân của trường là hai trường do thực dân Pháp thành lập là Trường Chuyên nghiệp Hà Nội năm 1898, và Trường Chuyên nghiệp Hải Phòng năm 1913. Qua nhiều lần sáp nhập, đổi tên, nâng cấp từ Trường Trung học Công nghiệp I (thành lập theo Quyết định số 580/QĐ-TCCB, năm 1997) lên Trường Cao đẳng Công nghiệp Hà Nội (thành lập theo Quyết định số 126/1999/QĐ-TTg, năm 1999) và Trường Đại học Công nghiệp Hà Nội (thành lập theo Quyết định số 315/2005/QĐ-TTg, năm 2005). Ngày 20/11/2025, Thủ tướng Chính phủ ban hành Quyết định số 2536/QĐ-TTg về việc chuyển Trường Đại học Công nghiệp Hà Nội thành Đại học Công nghiệp Hà Nội trở thành Đại học thứ 12 của cả nước. Bước sang giai đoạn phát triển mới, trường đẩy mạnh nghiên cứu và đổi mới sáng tạo, gắn kết chặt chẽ hoạt động nghiên cứu khoa học với chuyển giao công nghệ. Song song với đó, nhà trường chuẩn hóa đội ngũ giảng viên theo chuẩn quốc gia và quốc tế, nhằm cung cấp nguồn nhân lực chất lượng cao phục vụ chiến lược phát triển kinh tế - xã hội."@vi ;
    dbo:campus "50 ha" ;
    dbo:formerName "Trường Đại học Công nghiệp Hà Nội"@vi ;
    dbo:foundingYear 1898 ;
    dbo:motto "Giáo dục toàn diện, vì sự phát triển bền vững và hội nhập."@vi ;
    dbo:numberOfUndergraduateStudents "32000"^^xsd:nonNegativeInteger ;
    dbo:rector person:kieu-xuan-thuc ;

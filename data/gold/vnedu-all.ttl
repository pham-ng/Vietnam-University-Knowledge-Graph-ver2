university:truong-si-quan-cong-binh-dai-hoc-ngo-quyen a foaf:Organization,
        vnedu:EducationalOrganization,
        vnedu:HigherEducationInstitution,
        vnedu:MilitaryInstitution,
        vnedu:OfficerSchool,
        vnedu:Organization,
        vnedu:PublicInstitution,
        schema:CollegeOrUniversity,
        schema:EducationalOrganization,
        schema:Organization ;
    rdfs:label "Trường Sĩ quan Công binh – Đại học Ngô Quyền"@vi ;
    dbo:abstract "Trường Sĩ quan Công binh (SNH) (tên dân sự: Trường Đại học Ngô Quyền) là một trường đại học quân sự có trụ sở đặt tại thành phố Hồ Chí Minh, trực thuộc Binh chủng Công binh của Bộ Quốc phòng. Đào tạo cử nhân quân sự trình độ đại học các chuyên ngành chỉ huy kỹ thuật công binh và đào tạo cử nhân kỹ thuật hệ dân sự. Trường Đại học Sĩ quan Công binh là đơn vị sự nghiệp hệ công lập có tư cách pháp nhân, con dấu và tài khoản riêng. Ngày thành lập: 26 tháng 12 năm 1955. Trụ sở chính: 229B, đường Bạch Đằng, phường Thủ Dầu Một, thành phố Hồ Chí Minh."@vi ;
    dbo:foundingYear 1955 ;
    owl:sameAs wd:Q10828879 ;
    skos:prefLabel "Trường Sĩ quan Công binh – Đại học Ngô Quyền"@vi ;
    prov:wasDerivedFrom wd:Q10828879,
        <https://vi.wikipedia.org/w/index.php?oldid=75608947> ;
    foaf:isPrimaryTopicOf <https://vi.wikipedia.org/wiki/Tr%C6%B0%E1%BB%9Dng_S%C4%A9_quan_C%C3%B4ng_binh_%E2%80%93_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Ng%C3%B4_Quy%E1%BB%81n> ;
    vnedu:foundingYear 1955 ;
    vnedu:governedBy vnedu:MinistryOfNationalDefence,
        organization:binh-chung-cong-binh-cua-bo-quoc-phong ;
    vnedu:hasEducationParticipant person:nguyen-huu-hung ;
    vnedu:history "Trường Đại học Sĩ quan Công binh tiền thân là các lớp học đầu tiên do Cục Công binh tổ chức và Phân khoa Công binh, thuộc Trường Sĩ quan Lục quân 1 - Đại học Trần Quốc Tuấn. Ngày 26 tháng 12 năm 1955, tại thôn Nội Ninh, Ninh Sơn, Việt Yên, Hà Bắc (nay là Bắc Giang) khai giảng lớp học đầu tiên và từ đó, ngày 26/12 hàng năm trở thành Ngày truyền thống của Nhà trường. Tháng 3 năm 1956, di chuyển Phân hiệu Công binh từ Việt Yên về Đáp Cầu (thị xã Bắc Ninh, Hà Bắc) (nay là phường Đáp Cầu, thành phố Bắc Ninh, tỉnh Bắc Ninh); Ngày 27 tháng 4 năm 1964, Phân hiệu Công binh tách khỏi Trường Sĩ quan Lục quân 1 để tái thành lập Trường Đại học Sĩ quan Công binh. Ngày 8 tháng 8 năm 2013, Thủ tướng Chính phủ đã ký Quyết định số 1359/QĐ-TTg: Về việc thành lập Trường Đại học Ngô Quyền trên cơ sở Trường Đại học Sĩ quan Công binh. Trường Đại học Ngô Quyền có trụ sở chính tại thành phố Thủ Dầu Một, tỉnh Bình Dương. Ngày 20 tháng 9 năm 2013, Trường Đại học Ngô Quyền đã làm lễ công bố thành lập và khai giảng năm học 2013-2014."@vi ;
    vnedu:locatedIn country:viet-nam,
        province:thanh-pho-ho-chi-minh,
        region:nam-bo ;

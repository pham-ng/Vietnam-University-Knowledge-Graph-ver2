@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix university: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/university/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/dataset> a void:Dataset,
        dcat:Dataset ;
    dct:description "Cơ sở giáo dục đại học Việt Nam, cơ quan chủ quản, lãnh đạo, cựu sinh viên, đơn vị hành chính (gồm sắp xếp tỉnh 2025), ngành đào tạo — tích hợp và đối chiếu từ Wikidata và Wikipedia tiếng Việt."@vi ;
    dct:language <http://id.loc.gov/vocabulary/iso639-1/vi> ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:modified "2026-10-06"^^xsd:date ;
    dct:source <https://vi.wikipedia.org/>,
        <https://www.wikidata.org/> ;
    dct:title "VN-Edu Linked Open Data"@en,
        "Dữ liệu liên kết mở Giáo dục đại học Việt Nam"@vi ;
    void:dataDump <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/download/vnedu-all.ttl>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/download/vnedu-data.ttl>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/download/vnedu-links.ttl> ;
    void:entities 2213 ;
    void:exampleResource university:dai-hoc-bach-khoa-ha-noi ;
    void:sparqlEndpoint <http://localhost:3030/vnedu/sparql> ;
    void:subset <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/dataset/links-dbpedia-closeMatch>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/dataset/links-dbpedia-sameAs>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/dataset/links-geonames-sameAs>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/dataset/links-ror-sameAs>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/dataset/links-wikidata-closeMatch>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/dataset/links-wikidata-sameAs>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/dataset/links-wikipedia-isPrimaryTopicOf> ;
    void:triples 21610 ;
    void:uriSpace "https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/" ;
    void:vocabulary dbo:,
        geo:,
        skos:,
        prov:,
        foaf:,
        vnedu:,
        schema: ;
    dcat:distribution <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/download/vnedu-all.ttl>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/download/vnedu-data.ttl>,
        <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/download/vnedu-links.ttl> ;
    dcat:keyword "Vietnam",
        "giáo dục đại học",
        "higher education",
        "linked open data" .


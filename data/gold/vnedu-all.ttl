        schema:EducationalOrganization,
        schema:Organization ;
    rdfs:label "Thanh Do University"@en,
        "Trường Đại học Thành Đô"@vi ;
    dbo:abbreviation "TDU" ;
    dbo:abstract "Trường Đại học Thành Đô (tiếng Anh: Thanh Do University, viết tắt: TDU) là một trường đại học tư thục tại Hà Nội, Việt Nam. Được thành lập vào ngày 30 tháng 11 năm 2004 với tên gọi ban đầu là Trường Cao đẳng tư thục Công nghệ Thành Đô, đây là trường cao đẳng tư thục đầu tiên trong hệ thống giáo dục đại học Việt Nam. Trường chính thức được nâng cấp lên bậc đại học vào ngày 27 tháng 5 năm 2009 theo Quyết định số 679/QĐ-TTg của Thủ tướng Chính phủ. Trải qua hơn hai thập kỷ phát triển, Trường Đại học Thành Đô đã khẳng định vị thế là một trong những cơ sở giáo dục đại học tư thục uy tín, đạt chuẩn kiểm định chất lượng giáo dục quốc gia vào năm 2021 và đạt chuẩn quốc tế QS Stars 4 sao vào năm 2025. Trường đào tạo đa ngành, đa lĩnh vực, với triết lý giáo dục gắn kết chặt chẽ giữa nhà trường và doanh nghiệp, chú trọng phát triển kỹ năng thực hành và khả năng hội nhập quốc tế cho sinh viên."@vi ;
    dbo:campus "Gần 10 ha" ;
    dbo:foundingYear 2004 ;
    dbo:motto "Trí Tuệ - Năng Lực - Nhân Cách - Hòa Hợp Sáng Tạo - Chuyên Nghiệp - Uy Tín"@vi ;
    dbo:numberOfUndergraduateStudents "30000"^^xsd:nonNegativeInteger ;
    dbo:rector person:phan-thi-thanh-thao ;
    owl:sameAs wd:Q10829137,
        <https://ror.org/02scpdz59> ;
    skos:notation "TDD" ;
    skos:prefLabel "Trường Đại học Thành Đô"@vi ;
    prov:wasDerivedFrom wd:Q10829137,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=74962942> ;
    foaf:homepage <https://thanhdo.edu.vn> ;
    foaf:isPrimaryTopicOf <https://vi.wikipedia.org/wiki/Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Th%C3%A0nh_%C4%90%C3%B4> ;
    vnedu:address "Km 15, Quốc lộ 32, xã Kim Chung" ;
    vnedu:admissionCode "TDD" ;
    vnedu:campus "Gần 10 ha" ;
    vnedu:foundingYear 2004 ;
    vnedu:hasLeader person:phan-thi-thanh-thao ;
    vnedu:history """Tiền thân của Trường Đại học Thành Đô là Trường Cao đẳng tư thục Công nghệ Thành Đô, được thành lập ngày 30 tháng 11 năm 2004 theo Quyết định số 7687/QĐ-BGD&ĐT-TCCB của Bộ trưởng Bộ Giáo dục và Đào tạo. Đây là trường cao đẳng tư thục đầu tiên trong hệ thống giáo dục đại học Việt Nam, do Nhà giáo Nhân dân Ngô Xuân Độ sáng lập. Khóa sinh viên đầu tiên của trường có 600 sinh viên nhập học.

Ngày 26 tháng 6 năm 2006, trường được đổi tên thành Trường Cao đẳng Công nghệ Thành Đô theo Quyết định số 3207/QĐ-BGD&ĐT. Trong giai đoạn này, trường đã mở rộng quy mô đào tạo, tăng số lượng ngành học và khoa đào tạo. Năm 2007, trường được cấp 10 ha đất tại khu vực Lai Xá, Kim Chung, Hoài Đức, Hà Nội để xây dựng khu tổ hợp cơ sở vật chất giáo dục. Năm 2008, Trung tâm Đào tạo lái xe Thành Đô được thành lập, đánh dấu trường là đại học tư thục duy nhất tại Việt Nam có trung tâm đào tạo lái xe.

Ngày 27 tháng 5 năm 2009, một cột mốc quan trọng được ghi nhận khi Thủ tướng Chính phủ ký Quyết định số 679/QĐ-TTg nâng cấp Trường Cao đẳng Công nghệ Thành Đô lên thành Trường Đại học Thành Đô, trực thuộc Bộ Giáo dục và Đào tạo. Sự kiện này đánh dấu 5 năm thành lập và phát triển của nhà trường. Tiến sĩ Ngô Xuân Hà được bổ nhiệm làm Hiệu trưởng, trở thành hiệu trưởng trẻ nhất Việt Nam vào thời điểm đó.

Từ năm 2010, Trường Đại học Thành Đô đẩy mạnh hợp tác quốc tế, thiết lập quan hệ đối tác với các tổ chức giáo dục từ Nhật Bản, Hoa Kỳ và nhiều quốc gia khác. Năm 2012, đội tuyển sinh viên của trường đã giành chức vô địch cuộc thi "Lái xe sinh thái và tiết kiệm nhiên liệu" (EMC) do Honda tổ chức lần đầu tiên tại Việt Nam và đại diện cho khối các trường đại học Việt Nam tham dự vòng chung kết tại Tokyo, Nhật Bản.

Năm 2013, trường mở rộng lĩnh vực đào tạo sang khối ngành sức khỏe với việc mở mã ngành Dược học và Điều dưỡng. Năm 2017, trường đẩy mạnh đổi mới phương pháp giảng dạy, ứng dụng mô hình đào tạo kết hợp (blended learning) và tổ chức thành công Hội thảo khoa học quốc tế về công nghệ tế bào gốc từ màng dây rốn.

Năm 2018, trường ký kết hợp tác với 500 doanh nghiệp Hàn Quốc tại Việt Nam thông qua Hiệp hội K-BIZ, hiện thực hóa cam kết việc làm cho sinh viên sau tốt nghiệp. Năm 2021, Trường Đại học Thành Đô chính thức được Trung tâm Kiểm định chất lượng giáo dục - Đại học Quốc gia Hà Nội trao Giấy chứng nhận Kiểm định Chất lượng cơ sở giáo dục đại học."""@vi ;

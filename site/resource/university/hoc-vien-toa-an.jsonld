      "vnedu:motto": {
        "@language": "vi",
        "@value": "Kỷ cương – Đoàn kết – Năng động – Sáng tạo – Tự tin – Tự trọng – Ra sức thi đua dạy tốt, học tốt – hoàn thành xuất sắc nhiệm vụ được giao"
      },

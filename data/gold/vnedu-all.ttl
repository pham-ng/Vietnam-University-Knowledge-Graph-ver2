    rdfs:label "Hanoi Architectural University"@en,
        "Trường Đại học Kiến trúc Hà Nội"@vi ;
    dbo:abstract "Trường Đại học Kiến trúc Hà Nội (, thường được gọi tắt là HAU) là trường đại học chuyên ngành, giữ vai trò tiên phong trong đào tạo và nghiên cứu nhóm ngành kiến trúc, xây dựng và thiết kế tại Việt Nam, trực thuộc sự quản lý của Bộ Xây dựng. Với bề dầy lịch sử từ năm 1961 từ khi còn là một lớp đào tạo kiến trúc sư cho đến khi chính thức thành lập vào 17/9/1969 theo Quyết định 181/CP của Thủ tướng Phạm Văn Đồng, trường đã và đang đào tạo ra nhiều thế hệ kiến trúc sư, kỹ sư, nhà thiết kế tài năng, đóng góp cho sự phát triển của đất nước."@vi ;
    dbo:facultySize "507"^^xsd:nonNegativeInteger ;
    dbo:foundingYear 1969 ;
    dbo:motto "Chất lượng cao - Sáng tạo - Tiên phong - Tích hợp - Trách nhiệm - Phát triển bền vững"@vi ;
    dbo:numberOfPostgraduateStudents "227"^^xsd:nonNegativeInteger ;
    dbo:numberOfUndergraduateStudents "14281"^^xsd:nonNegativeInteger ;
    dbo:rector person:vu-ngoc-anh ;

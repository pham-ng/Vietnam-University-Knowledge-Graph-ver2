province:bac-ninh a vnedu:AdministrativeUnit,
        vnedu:Province,
        schema:AdministrativeArea ;
    rdfs:label "Bắc Ninh"@en,
        "Bắc Ninh"@vi ;
    owl:sameAs dbr:Bắc_Ninh_province,
        wd:Q33408,
        <https://sws.geonames.org/1905412/> ;
    geo:lat 21.1 ;
    geo:long 106.1 ;
    prov:wasDerivedFrom wd:Q33408 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/B%E1%BA%AFc_Ninh>,
        <https://vi.wikipedia.org/wiki/B%E1%BA%AFc_Ninh> ;
    vnedu:area 4719.0 ;
    vnedu:mergedFrom province:bac-giang ;
    vnedu:partOf country:viet-nam,
        region:bac-bo ;
    vnedu:population "3509200"^^xsd:nonNegativeInteger .


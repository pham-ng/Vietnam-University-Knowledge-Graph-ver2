@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix person: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/person/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix university: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/university/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .

person:pham-huy-quang a foaf:Person,
        vnedu:InstitutionLeader,
        vnedu:Person,
        schema:Person ;
    rdfs:label "Phạm Huy Quang"@vi ;
    foaf:name "Phạm Huy Quang" ;
    vnedu:honorific "TS" ;
    vnedu:leads university:truong-dai-hoc-san-khau-dien-anh-thanh-pho-ho-chi-minh .


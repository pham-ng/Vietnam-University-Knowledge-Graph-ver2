    skos:notation "GTP" ;
    skos:prefLabel "Trường Đại học Công nghệ Giao thông vận tải"@vi ;
    prov:wasDerivedFrom wd:Q20025751,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,

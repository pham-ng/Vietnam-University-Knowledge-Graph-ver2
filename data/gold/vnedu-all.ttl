    rdfs:label "Hanoi Law University"@en,
        "Trường Đại học Luật Hà Nội"@vi ;
    dbo:abbreviation "HLU" ;
    dbo:abstract "Trường Đại học Luật Hà Nội là trường đại học công lập đào tạo luật pháp của Việt Nam, trực thuộc Bộ Tư pháp và chịu sự quản lý nhà nước về giáo dục của Bộ Giáo dục và Đào tạo. Trường đang tổ chức đào tạo các bậc đại học, cao học, và nghiên cứu sinh. Trường có trụ sở chính tại số 87, đường Nguyễn Chí Thanh, phường Giảng Võ, thành phố Hà Nội, cơ sở 2 tại đường Hoàng Quốc Việt, phường Đồng Nguyên, thành phố Bắc Ninh và Phân hiệu tại tỉnh Đắk Lắk (thành lập tháng 3 năm 2019 trên cơ sở giải thể Trường Trung cấp Luật Buôn Ma Thuột)."@vi ;
    dbo:formerName "Trường Đại học Pháp lý Hà Nội"@vi ;
    dbo:foundingYear 1979 ;
    dbo:motto "Chất lượng cao tạo nên giá trị bền vững"@vi ;
    owl:sameAs wd:Q10829088,
        wd:Q30257165,
        wd:Q99298383 ;
    skos:notation "LPH" ;
    skos:prefLabel "Trường Đại học Luật Hà Nội"@vi ;
    prov:wasDerivedFrom wd:Q10829088,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75571652> ;

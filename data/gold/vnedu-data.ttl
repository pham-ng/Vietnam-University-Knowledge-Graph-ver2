        "VNU-UEB" ;
    vnedu:website <https://ueb.edu.vn> ;
    schema:email "news_ueb@vnu.edu.vn" ;
    schema:logo <https://upload.wikimedia.org/wikipedia/vi/7/7d/Logo_DHKT200x200.svg> ;
    schema:telephone "(84.24) 37547506" .


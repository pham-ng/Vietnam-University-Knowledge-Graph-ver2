  "dbo:abstract": {
    "@language": "vi",
    "@value": "Đại học Phenikaa (tiếng Anh: Phenikaa University) là một đại học tư thục đào tạo đa ngành tại Hà Nội. Đây là đại học thuộc Tập đoàn Phenikaa và là đại học thứ 10 của Việt Nam."
  },

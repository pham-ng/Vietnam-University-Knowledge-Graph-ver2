province:quang-nam a vnedu:AdministrativeUnit,
        vnedu:FormerProvince,
        schema:AdministrativeArea ;
    rdfs:label "Quảng Nam"@en,
        "Quảng Nam"@vi ;
    owl:sameAs dbr:Quảng_Nam_province,
        wd:Q33356,
        <https://sws.geonames.org/1905516/> ;
    geo:lat 15.55 ;
    geo:long 108.05 ;
    prov:wasDerivedFrom wd:Q33356 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Qu%E1%BA%A3ng_Nam_province>,
        <https://vi.wikipedia.org/wiki/Qu%E1%BA%A3ng_Nam> ;
    vnedu:area 10574.86 ;
    vnedu:mergedInto province:da-nang ;
    vnedu:population "1519380"^^xsd:nonNegativeInteger .


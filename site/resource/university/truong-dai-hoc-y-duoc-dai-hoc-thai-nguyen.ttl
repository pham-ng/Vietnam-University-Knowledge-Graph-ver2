    geo:long 105.825156 ;
    skos:altLabel "Phân hiệu Đại học Y khoa Miền núi (1968)",
        "Trường Đại học Y Bắc Thái (1975)",
        "Trường Đại học Y khoa (1994)" ;
    skos:prefLabel "Trường Đại học Y Dược, Đại học Thái Nguyên"@vi ;

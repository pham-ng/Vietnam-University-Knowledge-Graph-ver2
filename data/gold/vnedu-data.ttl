    schema:image <https://upload.wikimedia.org/wikipedia/vi/4/47/%C4%90%E1%BA%A1i_h%E1%BB%8Dc_h%C3%A0ng_h%E1%BA%A3i_Vi%E1%BB%87t_Nam.JPG> ;
    schema:logo <https://upload.wikimedia.org/wikipedia/vi/1/11/Bi%E1%BB%83u_tr%C6%B0ng_Tr%C6%B0%E1%BB%9Dng_%C4%91%E1%BA%A1i_h%E1%BB%8Dc_H%C3%A0ng_h%E1%BA%A3i_Vi%E1%BB%87t_Nam.svg> ;

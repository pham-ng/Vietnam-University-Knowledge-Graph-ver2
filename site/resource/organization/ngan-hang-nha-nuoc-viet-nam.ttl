@prefix dbr: <http://dbpedia.org/resource/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix organization: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/organization/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix university: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/university/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .

organization:ngan-hang-nha-nuoc-viet-nam a foaf:Organization,
        vnedu:GoverningBody,
        vnedu:Organization,
        schema:GovernmentOrganization,
        schema:Organization ;
    rdfs:label "Ngân hàng Nhà nước Việt Nam"@vi ;
    owl:sameAs dbr:State_Bank_of_Vietnam,
        wd:Q2234553 ;
    vnedu:governs university:hoc-vien-ngan-hang,
        university:truong-dai-hoc-ngan-hang-thanh-pho-ho-chi-minh .


province:ha-giang a vnedu:AdministrativeUnit,
        vnedu:FormerProvince,
        schema:AdministrativeArea ;
    rdfs:label "Hà Giang"@en,
        "Hà Giang"@vi ;
    owl:sameAs dbr:Hà_Giang_province,
        wd:Q36685,
        <https://sws.geonames.org/1581030/> ;
    geo:lat 22.75 ;
    geo:long 105.0 ;
    prov:wasDerivedFrom wd:Q36685 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/H%C3%A0_Giang_province>,
        <https://vi.wikipedia.org/wiki/H%C3%A0_Giang> ;
    vnedu:area 7927.55 ;
    vnedu:mergedInto province:tuyen-quang ;
    vnedu:population "892720"^^xsd:nonNegativeInteger .


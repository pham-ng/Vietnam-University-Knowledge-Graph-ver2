    vnedu:address "01 Nguyễn Văn Huyên" ;
    vnedu:campus "15 ha" ;
    vnedu:foundingYear "2007"^^xsd:gYear ;
    vnedu:hasLeader person:tran-lang ;
    vnedu:history "Được thành lập theo Quyết định số 112/QĐ-TTg ngày 24/01/2007 của Thủ tướng Chính phủ trên cơ sở sáp nhập và nâng cấp Trường CĐSP Phú Yên và Trường Trung học Kinh tế - Kỹ thuật Phú Yên."@vi ;

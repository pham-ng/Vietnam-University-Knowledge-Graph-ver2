prov:Entity a owl:Class .

vnedu:SourceObservation a owl:Class ;
    rdfs:label "Source-qualified observation"@en ;
    rdfs:comment "Reified source statement. Reification alone does not assert its content. Snapshot projections do not establish current validity."@en ;
    rdfs:subClassOf prov:Entity .

[] a owl:AllDisjointClasses ;
    owl:members ( vnedu:HigherEducationInstitution vnedu:Branch vnedu:VocationalCollege ) .

[] a owl:Class ;
    rdfs:subClassOf vnedu:MemberInstitution ;
    owl:intersectionOf ( vnedu:EducationalOrganization [ a owl:Restriction ;
                owl:onProperty vnedu:memberOf ;
                owl:someValuesFrom vnedu:HigherEducationInstitution ] ) .

[] a owl:Class ;
    rdfs:subClassOf vnedu:DefunctInstitution ;
    owl:intersectionOf ( vnedu:EducationalOrganization [ a owl:Restriction ;
                owl:onProperty vnedu:dissolutionYear ;
                owl:someValuesFrom xsd:integer ] ) .

[] a owl:Class ;
    rdfs:subClassOf vnedu:Alumnus ;
    owl:intersectionOf ( vnedu:Person [ a owl:Restriction ;
                owl:onProperty vnedu:alumnusOf ;
                owl:someValuesFrom vnedu:EducationalOrganization ] ) .

[] a owl:Class ;
    rdfs:subClassOf vnedu:InstitutionLeader ;
    owl:intersectionOf ( vnedu:Person [ a owl:Restriction ;
                owl:onProperty vnedu:leads ;
                owl:someValuesFrom vnedu:EducationalOrganization ] ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vnedu:Country vnedu:Region vnedu:Province vnedu:FormerProvince ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vnedu:Organization vnedu:Person vnedu:AdministrativeUnit ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vnedu:EducationalOrganization vnedu:GoverningBody vnedu:Company ) .

[] a owl:Restriction ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue vnedu:PrivateOwnership ;
            owl:onProperty vnedu:ownership ] ;
    owl:onProperty vnedu:ownedBy ;
    owl:someValuesFrom vnedu:Company .

[] a owl:Restriction ;
    rdfs:subClassOf vnedu:EducationParticipant ;
    owl:onProperty vnedu:educatedAt ;
    owl:someValuesFrom vnedu:EducationalOrganization .

[] a owl:AllDifferent ;
    owl:distinctMembers ( vnedu:PublicOwnership vnedu:PrivateOwnership ) .


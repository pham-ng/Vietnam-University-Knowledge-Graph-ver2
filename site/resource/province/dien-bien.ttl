    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/%C4%90i%E1%BB%87n_Bi%C3%AAn_province>,
        <https://vi.wikipedia.org/wiki/%C4%90i%E1%BB%87n_Bi%C3%AAn> ;
    vnedu:area 9539.93 ;
    vnedu:partOf country:viet-nam,
        region:bac-bo ;
    vnedu:population "656700"^^xsd:nonNegativeInteger .


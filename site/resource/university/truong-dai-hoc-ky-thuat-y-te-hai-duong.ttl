    rdfs:label "Hai Duong Medical Technical University"@en,
        "Trường Đại học Kỹ thuật Y tế Hải Dương"@vi ;
    dbo:abstract "Trường Đại học Kỹ thuật Y tế Hải Dương được thành lập ngày 12/7/2007, trụ sở của trường tọa lạc tại thành phố Hải Dương, tỉnh Hải Dương. Trường hoạt động theo cơ chế đại học công lập. Trực thuộc Bộ Y tế Việt Nam. Với gần 15 chuyên ngành đào tạo như: Bác sĩ đa khoa, Kĩ thuật hình ảnh y học, Kĩ thuật xét nghiệm đa khoa, Điều dưỡng đa khoa, Phục hồi chức năng, Điều dưỡng sản phụ khoa, Nữ hộ sinh...Trường là cơ sở đào tạo kỹ thuật viên y tế có trình độ đại học duy nhất ở miền Bắc, góp phần đáp ứng nhu cầu về nhân lực cho các tỉnh, thành phố miền bắc cũng như cả nước."@vi ;
    owl:sameAs wd:Q10829084,
        <https://ror.org/00gg7ff92> ;
    skos:prefLabel "Trường Đại học Kỹ thuật Y tế Hải Dương"@vi ;

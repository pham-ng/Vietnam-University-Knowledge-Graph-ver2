@prefix country: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/country/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix province: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/province/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix region: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/region/> .
@prefix schema: <https://schema.org/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .

region:nam-bo a vnedu:AdministrativeUnit,
        vnedu:Region,
        schema:AdministrativeArea ;
    rdfs:label "Southern Vietnam"@en,
        "Nam Bộ"@vi ;
    owl:sameAs wd:Q2289221 ;
    vnedu:hasPart province:an-giang,
        province:ca-mau,
        province:can-tho,
        province:dong-nai,
        province:dong-thap,
        province:tay-ninh,
        province:thanh-pho-ho-chi-minh,
        province:vinh-long ;
    vnedu:partOf country:viet-nam .


    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Ninh_Thu%E1%BA%ADn_province>,
        <https://vi.wikipedia.org/wiki/Ninh_Thu%E1%BA%ADn> ;
    vnedu:area 3355.7 ;
    vnedu:mergedInto province:khanh-hoa ;
    vnedu:population "598680"^^xsd:nonNegativeInteger .


    rdfs:label "Nguyen Tat Thanh University"@en,
        "Trường Đại học Nguyễn Tất Thành"@vi ;
    dbo:abstract "Trường Đại học Nguyễn Tất Thành là một đại học tư thục tại Việt Nam. Được thành lập vào 5 tháng 6 năm 1999 thuộc quản lý của bộ GD&ĐT . Trước đây là trường công lập sau được sáp nhập thành trường tư nhưng vẫn được điều hành bởi nhà nước Việt Nam Trường hiện có 14 khoa, 54 chương trình đào tạo các bậc thuộc các khối ngành: Sức khỏe, Kinh tế, Xã hội – Nhân văn, Kỹ thuật – Công nghệ, Nghệ thuật – Mỹ thuật."@vi ;
    owl:sameAs wd:Q10829104,
        <https://ror.org/04r9s1v23> ;
    geo:lat 10.662223 ;
    geo:long 106.72113 ;
    skos:prefLabel "Trường Đại học Nguyễn Tất Thành"@vi ;
    prov:wasDerivedFrom wd:Q10829104,
        <https://vi.wikipedia.org/w/index.php?oldid=74533372> ;
    foaf:homepage <http://ntt.edu.vn/ntt_trangchu/> ;
    foaf:isPrimaryTopicOf <https://vi.wikipedia.org/wiki/Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Nguy%E1%BB%85n_T%E1%BA%A5t_Th%C3%A0nh> ;
    vnedu:address "300A Nguyễn Tất Thành, phường Xóm Chiếu" ;
    vnedu:foundingYear "1999"^^xsd:gYear ;
    vnedu:hasLeader person:tran-ai-cam ;
    vnedu:history """Ra đời năm 1999, trường Đại học Nguyễn Tất Thành khi đó lấy tên gọi là Trung tâm đào tạo Công nhân may thuộc Công ty Dệt may Sài Gòn. Đến năm 2002, trường đổi tên thành Trường Kinh tế Kỹ thuật nghiệp vụ Bán công Nguyễn Tất Thành cho phù hợp hơn với các lĩnh vực đào tạo và nhiệm vụ.

Năm 2005, Đại học Nguyễn Tất Thành có nhiều bước tiến và những phát triển nổi bật, đổi tên thành Trường Cao đẳng Kinh tế Kỹ thuật nghiệp vụ Bán công Nguyễn Tất Thành. Sang năm 2006, trường lấy tên gọi là trường Cao đẳng Nguyễn Tất Thành và từ năm 2011, trường nổi danh với tên gọi Đại học Nguyễn Tất Thành cho đến ngày nay."""@vi ;
    vnedu:locatedIn country:viet-nam,
        province:thanh-pho-ho-chi-minh,
        region:nam-bo ;

    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/H%C3%A0_T%C4%A9nh_province>,
        <https://vi.wikipedia.org/wiki/H%C3%A0_T%C4%A9nh> ;
    vnedu:area 5994.45 ;

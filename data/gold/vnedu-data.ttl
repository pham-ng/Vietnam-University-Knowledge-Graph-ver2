    vnedu:memberOf university:dai-hoc-quoc-gia-thanh-pho-ho-chi-minh ;
    vnedu:motto "Thống nhất - Vượt trội - Tiên phong"@vi ;
    vnedu:ownership vnedu:PublicOwnership ;

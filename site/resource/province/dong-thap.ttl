    geo:long 106.0 ;
    prov:wasDerivedFrom wd:Q36676 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/%C4%90%E1%BB%93ng_Th%C3%A1p_province>,
        <https://vi.wikipedia.org/wiki/%C4%90%E1%BB%93ng_Th%C3%A1p> ;

  "EducationalOrganization" -> "Major" [label="trainsMajor", color="#3B3B3B", fontcolor="#1F1F1F"];
  "EducationalOrganization" -> "Organization" [arrowhead=empty, style=dashed, color="#A0A0A0"];
  "GoverningBody" -> "Organization" [arrowhead=empty, style=dashed, color="#A0A0A0"];
  "Company" -> "Organization" [arrowhead=empty, style=dashed, color="#A0A0A0"];

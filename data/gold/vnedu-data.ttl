university:truong-dai-hoc-lam-nghiep a vnedu:UniversitySchool ;
    rdfs:label "Vietnam National University of Forestry"@en,
        "Trường Đại học Lâm nghiệp"@vi ;
    dbo:abstract "Trường Đại học Lâm nghiệp Việt Nam (tên giao dịch quốc tế: Vietnam National University of Forestry, viết tắt VNUF) là một trường đào tạo đa ngành bậc đại học và sau đại học ở Việt Nam. Trường trực thuộc Bộ Nông nghiệp và Môi trường."@vi ;
    geo:lat 20.861247 ;
    geo:long 105.602474 ;
    skos:prefLabel "Trường Đại học Lâm nghiệp"@vi ;
    prov:wasDerivedFrom wd:Q10829090,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75454049> ;
    vnedu:address "xã Xuân Mai" ;
    vnedu:admissionCode "LNH" ;
    vnedu:councilChair person:cao-quoc-an ;
    vnedu:formerName "Học viện Nông Lâm"@vi,
        "Đại học Lâm nghiệp Việt Nam"@vi,
        "Đại học Nông Lâm"@vi ;
    vnedu:foundingYear 1956 ;
    vnedu:history "Trường được thành lập ngày 12 tháng 10 năm 1956 với tên gọi Đại học Nông Lâm rồi Học viện Nông Lâm (1958), trường gồm 2 khoa chủ chốt là Nông học và Lâm học. Theo Quyết định 127/CP ngày 19 tháng 8 năm 1964 của Thủ tướng Chính phủ, trường tách thành hai trường độc lập là: Đại học Nông nghiệp (nay là Học viện Nông nghiệp) và Đại học Lâm nghiệp. Trường Đại học Lâm nghiệp được thiết lập trên cơ sở khoa Lâm học và tổ cơ khí lâm nghiệp. Sau khi thành lập, trường đào tạo gồm ba ngành chính: Lâm nghiệp, Kinh tế và Công nghiệp rừng. Thời kỳ đầu do thành lập khi đất nước còn chiến tranh nên cơ sở ban đầu của trường đặt tại Đông Triều, Quảng Ninh. Từ tháng 5 năm 1985 trường chuyển về cơ sở tại Xuân Mai, Hà Nội, xây dựng và phát triển cho tới nay. Vào năm 1995 thực hiện chủ trương mở rộng đào tạo của Bộ Lâm nghiệp, trường mở rộng thêm quy mô đào tạo và các ngành nghề mới, với các khoa: Lâm học (tiền thân là khoa Lâm nghiệp), Quản lý tài nguyên rừng và môi trường (tiền thân là khoa Lâm nghiệp), Chế biến lâm sản (tiền thân là khoa Công nghiệp rừng), Công nghiệp phát triển nông thôn (tiền thân là khoa Công nghiệp rừng), Quản trị kinh doanh. Bộ Lâm nghiệp cũng quyết định và gọi tên trường là Đại học Lâm nghiệp Việt Nam. Năm 2008 trường thành lập cơ sở 2 tại thị trấn Trảng Bom, huyện Trảng Bom, tỉnh Đồng Nai, trên cơ sở sáp nhập trường Trung cấp dạy nghề Lâm nghiệp Đồng Nai. Ngày 1 tháng 12 năm 2015, ông Trần Văn Chứ, Hiệu trưởng nhà trường ký Thông báo số 2181/ĐHLN-CT&CTSV về việc sử dụng tên gọi chính trong tiếng Việt của trường là Đại học Lâm nghiệp. Ngày 5 tháng 10 năm 2016, Bộ Giáo dục và Đào tạo ra Quyết định số 4213/QĐ-BGDĐT về việc thành lập Phân hiệu Trường Đại học Lâm nghiệp tại tỉnh Đồng Nai. Năm 2018, Trường THPT Lâm nghiệp được thành lập nằm trong khuôn viên trường Đại học Lâm nghiệp. Ngày 20 tháng 7 năm 2020, Bộ Giáo dục và Đào tạo ra Quyết định số 2020/QĐ-BGDĐT về việc thành lập Phân hiệu Trường Đại học Lâm nghiệp tại tỉnh Gia Lai. Ngày 17 tháng 5 năm 2021, UBND tỉnh Đồng Nai ra Quyết định số 1628/QĐ-UBND về việc thành lập Trường Trung học phổ thông Lâm nghiệp Đồng Nai, trụ sở nằm trong khuôn viên Phân hiệu Trường Đại học Lâm nghiệp tại Đồng Nai."@vi ;
    vnedu:locatedIn province:ha-noi ;
    vnedu:motto "Lâm nghiệp nâng bước - Đất nước phồn vinh"@vi ;
    vnedu:ownership vnedu:PublicOwnership ;
    vnedu:rector person:pham-van-dien ;
    vnedu:reportedGovernedBy organization:bo-nong-nghiep-va-moi-truong ;
    vnedu:shortName "VNUF" ;
    vnedu:website <https://vnuf.edu.vn> ;
    schema:email "vnuf@vnuf.edu.vn" ;
    schema:logo <https://upload.wikimedia.org/wikipedia/vi/0/0f/Logo_vnuf.jpg> ;
    schema:telephone "024 33840233" .


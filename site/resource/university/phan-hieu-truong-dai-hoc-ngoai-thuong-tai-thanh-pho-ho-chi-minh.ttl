    rdfs:label "Foreign Trade University, Ho Chi Minh City Branch"@en,
        "Phân hiệu Trường Đại học Ngoại thương tại Thành phố Hồ Chí Minh"@vi ;
    dbo:abstract "Phân hiệu Trường Đại học Ngoại thương tại Thành phố Hồ Chí Minh (tiếng Anh: Foreign Trade University, Ho Chi Minh City Branch, Phân hiệu FTU tại TP.HCM) là cơ sở đào tạo phía Nam của Trường Đại học Ngoại thương tại Hà Nội, cơ sở giáo dục đại học chuyên ngành kinh tế đầu ngành tại Việt Nam, thành viên của Bộ Giáo dục và Đào tạo. Cơ sở được thành lập dựa trên nhu cầu đào tạo cán bộ trong lĩnh vực kinh tế và kinh doanh quốc tế của các tỉnh thành phía Nam trong giai đoạn hội nhập kinh tế quốc tế. Được thành lập theo Quyết định số 1485/GD-ĐT ngày 16 tháng 7 năm 1993 của Bộ trưởng Bộ Giáo dục và Đào tạo Việt Nam."@vi ;
    owl:sameAs wd:Q10829100 ;
    geo:lat 10.799291 ;
    geo:long 106.717844 ;
    skos:prefLabel "Phân hiệu Trường Đại học Ngoại thương tại Thành phố Hồ Chí Minh"@vi ;

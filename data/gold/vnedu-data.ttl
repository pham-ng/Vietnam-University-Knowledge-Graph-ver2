    schema:telephone "02838393658" .

university:truong-dai-hoc-y-duoc-dai-hoc-hue a vnedu:UniversitySchool ;
    rdfs:label "Trường Đại học Y Dược, Đại học Huế"@vi ;
    dbo:abstract "Trường Đại học Y Dược (YDH; ) là một trong những trung tâm đào tạo, nghiên cứu khoa học và chăm sóc sức khỏe hàng đầu khối ngành khoa học sức khỏe tại miền Trung, Tây Nguyên và cả nước. Nhà trường là trung tâm nghiên cứu khoa học, chuyển giao công nghệ, hợp tác quốc tế, với nhiều đề tài, dự án có giá trị thực tiễn cao, góp phần nâng cao chất lượng khám chữa bệnh, chăm sóc sức khỏe cộng đồng. Trường Đại học Y dược, Đại học Huế là 1 trong 3 cơ sở Đại học hàng đầu khu vực về đào tạo ngành Y dược lớn nhất cả nước."@vi ;
    skos:prefLabel "Trường Đại học Y Dược, Đại học Huế"@vi ;
    prov:wasDerivedFrom wd:Q10829171,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75580875> ;
    vnedu:academicStaff "334"^^xsd:nonNegativeInteger ;
    vnedu:address "06 Ngô Quyền, phường Thuận Hóa" ;
    vnedu:admissionCode "DHY" ;
    vnedu:foundingYear 1957 ;
    vnedu:history "Trường Đại học Y - Dược, Đại học Huế tiền thân là Khoa Y thuộc Viện đại học Huế, được thành lập ngày 28 tháng 3 năm 1957. Đến năm 1961, Trường được đổi tên thành Trường Đại học Y khoa Huế thuộc Viện Đại học Huế. Năm 1979, Trường Đại học Y khoa Huế và Bệnh viện Trung ương Huế được hợp nhất để trở thành Học viện Y Huế trực thuộc Bộ Y tế. Đến năm 1989, Trường Đại học Y khoa Huế lại được tách ra và trực thuộc Bộ Y tế. Từ năm 1994, Trường Đại học Y khoa Huế trở thành trường đại học thành viên của Đại học Huế, trực thuộc Bộ Giáo dục và Đào tạo theo Nghị định số 30-CP ngày 04 tháng 4 năm 1994 của Chính phủ. Ngày 26 tháng 3 năm 2007, Trường Đại học Y khoa Huế được đổi tên thành Trường Đại học Y - Dược, Đại học Huế theo quyết định số 334/QĐ-TTg của Thủ tướng Chính phủ. Ngày 23 tháng 10 năm 2025, Thủ tướng Chính phủ ký quyết định số 2346/QĐ-TTg về việc sáp nhập Trường Cao đẳng Y tế Huế vào Trường Đại học Y - Dược, Đại học Huế để phát triển theo mô hình Trường - Viện cấp quốc gia hướng đến đạt tiêu chuẩn quốc tế theo tinh thần Nghị quyết số 54-NQ/TW ngày 10 tháng 12 năm 2019 của Bộ Chính trị. Ngày 23/10/2025, Thủ tướng Chính phủ ký Quyết định số 2346/QĐ-TTg về việc sáp nhập Trường Cao đẳng Y tế Huế trực thuộc UBND thành phố Huế vào Trường Đại học Y - Dược, Đại học Huế. Trường Cao đẳng Y tế Huế tiền thân là Trường y tá quốc gia Huế được thành lập theo Nghị số 2008 ngày 12/04/1948 của Khâm sứ Nam Kỳ, Nghị định số 1038 ngày 03/04/1950 của Thủ Hiến Bắc Việt, và Nghị định số 64 ngày 29/12/1951 của Thủ Hiến Trung Việt. Sau ngày Thừa Thiên Huế được giải phóng (26/3/1975), ngành y tế tiếp quản 2 trường Cán sự điều dưỡng Huế và trường Nữ hộ sinh để thành lập trường Cán bộ Y tế Thừa Thiên Huế. Tháng 6/1976 khi hợp nhất 3 tỉnh Bình Trị Thiên, 3 trường Cán bộ Y tế Thừa Thiên Huế, Quảng Bình, Quảng Trị được sáp nhập lại thành Trường Trung học Y tế Bình Trị Thiên. Nhiệm vụ chủ yếu của Trường là đào tạo Y sĩ đa khoa, nữ hộ sinh, y tá điều dưỡng phục vụ trên địa bàn 3 tỉnh Quảng Bình, Quảng Trị, Thừa Thiên Huế. Đến tháng 7/1989, Trường Trung học Y tế Bình Trị Thiên được đổi tên thành Trường Trung học Y tế Thừa Thiên Huế làm nhiệm vụ đào tạo cán bộ y tế trung học cho 3 tỉnh Quảng Bình, Quảng Trị và Thừa Thiên Huế. Đến tháng 11/2005, trường Trung học Y tế Thừa Thiên Huế được nâng cấp thành trường Cao đẳng Y tế Huế trực thuộc UBND tỉnh Thừa Thiên Huế theo Quyết định số 6284/QĐ-BGD&ĐT của Bộ Giáo dục và Đào tạo."@vi ;
    vnedu:locatedIn province:hue ;
    vnedu:memberOf university:dai-hoc-hue ;

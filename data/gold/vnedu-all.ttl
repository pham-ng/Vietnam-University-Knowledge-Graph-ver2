    rdfs:label "VNU School of Business and Management"@en,
        "Trường Quản trị và Kinh doanh, Đại học Quốc gia Hà Nội"@vi ;
    dbo:abbreviation "HSB" ;
    dbo:abstract "Trường Quản trị và Kinh doanh - Đại học Quốc gia Hà Nội (tên tiếng Anh: VNU Hanoi School of Business and Management, viết tắt là HSB) là một đơn vị trực thuộc Đại học Quốc gia Hà Nội - đại học trong nhóm trọng điểm quốc gia và đại học tinh hoa của Việt Nam. Trường được thành lập ngày 13 tháng 7 năm 1995 theo quyết định của cố giáo sư, viện sĩ Nguyễn Văn Đạo, giám đốc đầu tiên của Đại học Quốc gia Hà Nội. Bên cạnh lĩnh vực quản trị kinh doanh, trường cũng là nơi tiên phong đào tạo lĩnh vực an ninh phi truyền thống đại học và sau đại học đầu tiên ở Việt Nam. Đây là trường đại học công lập đầu tiên của Việt Nam đạt chuẩn QS 5 sao."@vi ;
    dbo:campus "Nội thành" ;
    dbo:foundingYear 1995 ;
    dbo:motto "Sáng tạo - Tiên phong - Chất lượng"@vi ;
    dbo:rector person:hoang-dinh-phi ;
    owl:sameAs wd:Q10779338,
        <https://ror.org/04w94d148> ;
    geo:lat 21.036807 ;
    geo:long 105.785613 ;
    skos:notation "QHD" ;

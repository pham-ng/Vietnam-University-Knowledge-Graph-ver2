university:dai-hoc-duy-tan a vnedu:University ;
    rdfs:label "Duy Tan University"@en,
        "Đại học Duy Tân"@vi ;
    dbo:abstract "Đại học Duy Tân (tiếng Anh: Duy Tan University) là đại học tư thục đầu tiên và lớn nhất tại miền Trung Việt Nam, tiền thân là Trường Đại học Duy Tân, thành lập năm 1994. Năm 2019, trường được trao Huân chương Lao động hạng Nhất. Ngày 7 tháng 10 năm 2024, Phó Thủ tướng Chính phủ Lê Thành Long ký Quyết định số 1115/QĐ-TTg chuyển Trường Đại học Duy Tân thành Đại học Duy Tân. Đại học Duy Tân trở thành Đại học thứ 8 tại Việt Nam sau Đại học Quốc gia Hà Nội, Đại học Quốc gia Thành phố Hồ Chí Minh, Đại học Thái Nguyên, Đại học Huế, Đại học Đà Nẵng, Đại học Bách khoa Hà Nội và Đại học Kinh tế Thành phố Hồ Chí Minh. Đại học Duy Tân cũng là cơ sở giáo dục tư thục đầu tiên được chuyển đổi từ “Trường Đại học” lên thành “Đại học”. Trường hợp tác với nhiều Đại học quốc tế, có mặt trong các bảng xếp hạng đại học quốc tế. Tuy nhiên, trường gây nhiều tranh cãi trong dư luận xung quanh sai phạm về liêm chính trong nghiên cứu khoa học, sa thải giảng viên vì bình luận về cách chính quyền xử lý đại dịch COVID-19, sai phạm về tuyển sinh, sử dụng người lao động và tài chính."@vi ;
    geo:lat 16.0601 ;
    geo:long 108.21 ;
    skos:prefLabel "Đại học Duy Tân"@vi ;
    prov:wasDerivedFrom wd:Q5317667,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75610504> ;
    vnedu:address "254 Nguyễn Văn Linh, phường Thanh Khê" ;
    vnedu:admissionCode "DDT" ;
    vnedu:director person:le-nguyen-bao ;
    vnedu:foundingYear 1994 ;
    vnedu:history """Trường Đại học Duy Tân được thành lập vào ngày 11/11/1994 theo Quyết định Số 666/TTg của Thủ tướng Chính phủ. Nhà giáo Ưu tú Lê Công Cơ là Hiệu trưởng đầu tiên.

Năm 2002, Cơ sở 254 Nguyễn Văn Linh được đưa vào vận hành. Năm 2018, Tiến sĩ Lê Nguyên Bảo tiếp nhận và trở thành Hiệu trưởng tiếp theo của Trường Đại học Duy Tân.

Ngày 07/10/2024 Trường Đại học Duy Tân được chuyển thành Đại học Duy Tân và là Đại học thứ 8 tại Việt Nam."""@vi ;
    vnedu:locatedIn province:da-nang ;
    vnedu:motto "\"Bản lĩnh Việt Nam – Đổi mới, Sáng tạo, Vươn tới những tầm cao!\""@vi ;
    vnedu:ownership vnedu:PrivateOwnership ;
    vnedu:shortName "DTU" ;
    vnedu:website <https://duytan.edu.vn> ;
    schema:email "vanphong@duytan.edu.vn" ;
    schema:image <https://upload.wikimedia.org/wikipedia/commons/1/19/Duy_Tan_University.jpg> ;
    schema:logo <https://upload.wikimedia.org/wikipedia/vi/1/12/Logo_dtu_footer.png> ;
    schema:telephone "(+84) 236.3747678" .

university:hoc-vien-hanh-chinh-va-quan-tri-cong a vnedu:Academy ;
    rdfs:label "Academy of Public Administration and Governance"@en,
        "Học viện Hành chính và Quản trị công"@vi ;
    dbo:abstract "Học viện Hành chính và Quản trị công (tên tiếng Anh: Academy of Public Administration and Governance; APAG) là đơn vị sự nghiệp công lập trực thuộc Học viện Chính trị Quốc gia Hồ Chí Minh, đơn vị chịu sự quản lý của Ban Chấp hành Trung ương Đảng Cộng sản Việt Nam. Học viện có chức năng đào tạo, bồi dưỡng năng lực, kiến thức, kỹ năng cho đội ngũ cán bộ, công chức, viên chức của Đảng & Nhà nước Việt Nam về hành chính, lãnh đạo, quản lý của toàn bộ nền công vụ Việt Nam."@vi ;
    geo:lat 21.026251 ;
    geo:long 105.81153 ;
    skos:prefLabel "Học viện Hành chính và Quản trị công"@vi ;
    prov:wasDerivedFrom wd:Q10771885,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75599552> ;
    vnedu:address "số 77 đường Nguyễn Chí Thanh, phường Láng Thượng, quận Đống Đa, thủ đô Hà Nội, nước Việt Nam" ;
    vnedu:admissionCode "HCH" ;
    vnedu:director person:nguyen-ba-chien-2 ;
    vnedu:formerName "Học viện Hành chính"@vi,
        "Học viện Hành chính Quốc gia"@vi,
        "Trường Hành chính"@vi ;
    vnedu:foundingYear 1959 ;
    vnedu:history """Học viện Hành chính và Quản trị công tiền thân là Trường Hành chính, được thành lập năm 1959 trực thuộc Bộ Nội vụ, với nhiệm vụ huấn luyện cán bộ chính quyền cấp huyện. Trường đặt tại huyện Từ Sơn, tỉnh Bắc Ninh và khai giảng khóa đầu tiên vào ngày 16 tháng 10 năm 1959.

Năm 1961, trường được đổi tên thành Trường Hành chính Trung ương và chuyển trụ sở về Láng Hạ, Hà Nội. Năm 1980, trường được sáp nhập với Trường Kinh tế Trung ương thành Trường Hành chính – Kinh tế Trung ương; đến năm 1981 được tách trở lại thành Trường Hành chính Trung ương.

Năm 1990, trường đổi tên thành Trường Hành chính Quốc gia; đến năm 1992 đổi tên thành Học viện Hành chính Quốc gia.

Giai đoạn 2007–2013, Học viện trực thuộc Học viện Chính trị Quốc gia Hồ Chí Minh với tên gọi Học viện Hành chính. Từ năm 2013, Học viện trở lại trực thuộc Bộ Nội vụ theo Nghị quyết số 121/NQ-CP.

Năm 2017, Học viện tiếp nhận Trường Đào tạo, bồi dưỡng cán bộ, công chức trực thuộc Bộ Nội vụ. Năm 2022, Trường Đại học Nội vụ Hà Nội được sáp nhập vào Học viện.

Từ năm 2025, Học viện mang tên Học viện Hành chính và Quản trị công và trực thuộc Học viện Chính trị Quốc gia Hồ Chí Minh."""@vi ;
    vnedu:locatedIn province:ha-noi ;
    vnedu:memberOf university:hoc-vien-chinh-tri-quoc-gia-ho-chi-minh ;
    vnedu:motto "Trí tuệ - Chất lượng - Hiện đại"@vi ;
    vnedu:ownership vnedu:PublicOwnership ;
    vnedu:shortName "APAG",
        "HVHC&QTC",
        "NAPA" ;
    vnedu:website <https://apag.edu.vn> ;
    schema:email "tuyensinh.dnv@gmail.com" ;
    schema:foundingDate "1959-05-29T00:00:00"^^xsd:dateTime ;
    schema:logo <https://upload.wikimedia.org/wikipedia/commons/9/93/Logo_H%E1%BB%8Dc_vi%E1%BB%87n_H%C3%A0nh_ch%C3%ADnh_v%C3%A0_Qu%E1%BA%A3n_tr%E1%BB%8B_c%C3%B4ng.png> ;
    schema:telephone "043-8343223" .

university:hoc-vien-thanh-thieu-nien-viet-nam a vnedu:Academy ;
    rdfs:label "Vietnam Youth Academy"@en,
        "Học viện Thanh thiếu niên Việt Nam"@vi ;
    dbo:abstract "Học viện Thanh thiếu niên Việt Nam là 1 học viện hệ công lập đào tạo với vai trò bồi dưỡng tư cách đạo đức, lý luận chính trị cho thanh niên Việt Nam. Học viện có 2 cơ sở, 1 tại thủ đô Hà Nội, và cơ sở còn lại tại thành phố Hồ Chí Minh. Học viện trực thuộc Đoàn Thanh niên Cộng sản Hồ Chí Minh. Năm 1995, học viện thành lập trên cơ sở tổ chức lại hệ thống đào tạo, nghiên cứu và thông tin khoa học của Trung ương Đoàn, dựa trên cơ sở hợp nhất 3 thành viên là: Trường cao cấp thanh niên, Viện nghiên cứu thanh niên, và Phân viện miền Nam. Học viện nhận Huân chương Lao động hạng 3 năm 1981."@vi ;
    skos:prefLabel "Học viện Thanh thiếu niên Việt Nam"@vi ;

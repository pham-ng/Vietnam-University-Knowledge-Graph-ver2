province:da-nang a vnedu:AdministrativeUnit,
        vnedu:CentrallyGovernedCity,
        vnedu:Province,
        schema:AdministrativeArea ;
    rdfs:label "Da Nang"@en,
        "Đà Nẵng"@vi ;
    owl:sameAs dbr:Da_Nang,
        wd:Q25282,
        <https://sws.geonames.org/1905468/> ;
    geo:lat 16.069444444 ;
    geo:long 108.209722222 ;
    prov:wasDerivedFrom wd:Q25282 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Da_Nang>,
        <https://vi.wikipedia.org/wiki/%C4%90%C3%A0_N%E1%BA%B5ng> ;
    vnedu:area 11860.0 ;
    vnedu:mergedFrom province:quang-nam ;
    vnedu:partOf country:viet-nam,
        region:trung-bo ;
    vnedu:population "2819900"^^xsd:nonNegativeInteger .


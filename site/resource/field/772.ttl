@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .

field:772 a skos:Concept,
        vnedu:FieldOfStudy ;
    rdfs:label "Health"@en,
        "Sức khỏe"@vi ;

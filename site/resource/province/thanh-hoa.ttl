province:thanh-hoa a vnedu:AdministrativeUnit,
        vnedu:Province,
        schema:AdministrativeArea ;
    rdfs:label "Thanh Hóa"@en,
        "Thanh Hóa"@vi ;
    owl:sameAs dbr:Thanh_Hóa_province,
        wd:Q36512,
        <https://sws.geonames.org/1566165/> ;
    geo:lat 20.0 ;
    geo:long 105.5 ;
    prov:wasDerivedFrom wd:Q36512 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Thanh_H%C3%B3a_province>,
        <https://vi.wikipedia.org/wiki/Thanh_H%C3%B3a> ;
    vnedu:area 11114.71 ;
    vnedu:partOf country:viet-nam,
        region:trung-bo ;
    vnedu:population "3764200"^^xsd:nonNegativeInteger .


@prefix dbr: <http://dbpedia.org/resource/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix organization: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/organization/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .

organization:tap-doan-vingroup a foaf:Organization,
        vnedu:Company,
        vnedu:Organization,
        schema:Corporation,
        schema:Organization ;
    rdfs:label "Tập đoàn Vingroup"@vi ;
    owl:sameAs dbr:Vingroup,
        wd:Q10831597 .


university:truong-dai-hoc-hoa-sen a vnedu:UniversitySchool ;
    rdfs:label "Hoa Sen University"@en,
        "Trường Đại học Hoa Sen"@vi ;
    dbo:abstract "Trường Đại học Hoa Sen (HSU) là một trường đại học của Việt Nam đào tạo các ngành kinh tế, kinh doanh và quản lý, du lịch, công nghệ, thiết kế nghệ thuật và ngôn ngữ."@vi ;
    geo:lat 10.770454 ;
    geo:long 106.692519 ;
    skos:altLabel "Hoa Sen University, Université Hoa Sen" ;
    skos:prefLabel "Trường Đại học Hoa Sen"@vi ;
    prov:wasDerivedFrom wd:Q1002930,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75551176> ;
    vnedu:address "Trụ sở chính / Cơ sở 1: 8 Nguyễn Văn Tráng, P. Bến Thành, Thành phố Hồ Chí Minh" ;
    vnedu:admissionCode "HSU" ;
    vnedu:foundingYear 1991 ;
    vnedu:history """Trường được thành lập năm 1991 với tên gọi Trường Nghiệp vụ Tin học và Quản lý Hoa Sen. Năm 1994, trường Hoa Sen trở thành trường bán công. Năm 1996, trường đã chuyển trụ sở đến tòa nhà số 8 Nguyễn Văn Tráng.

Năm 1999, Thủ tướng Chính phủ ra quyết định công nhận thành lập Trường Cao đẳng Bán công Hoa Sen. Ngày 30 tháng 11 năm 2006, trường được nâng cấp thành Trường Đại học Hoa Sen. Năm 2016, Trường Đại học Hoa Sen được cấp phép đào tạo thạc sĩ chuyên ngành Quản trị Kinh doanh.

Năm 2018, Tập đoàn giáo dục Nguyễn Hoàng mua lại Trường Đại học Hoa Sen."""@vi ;
    vnedu:locatedIn province:thanh-pho-ho-chi-minh ;
    vnedu:motto "Tôn trọng sự khác biệt"@vi ;
    vnedu:ownedBy organization:tap-doan-giao-duc-nguyen-hoang ;
    vnedu:ownership vnedu:PrivateOwnership ;

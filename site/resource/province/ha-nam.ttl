province:ha-nam a vnedu:AdministrativeUnit,
        vnedu:FormerProvince,
        schema:AdministrativeArea ;
    rdfs:label "Hà Nam"@en,
        "Hà Nam"@vi ;
    owl:sameAs dbr:Hà_Nam_province,
        wd:Q36413,
        <https://sws.geonames.org/1905637/> ;
    geo:lat 20.533333333 ;
    geo:long 105.966666666 ;
    prov:wasDerivedFrom wd:Q36413 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/H%C3%A0_Nam_province>,
        <https://vi.wikipedia.org/wiki/H%C3%A0_Nam_%28t%E1%BB%89nh_Vi%E1%BB%87t_Nam%29> ;
    vnedu:area 861.93 ;
    vnedu:mergedInto province:ninh-binh ;
    vnedu:population "878000"^^xsd:nonNegativeInteger .


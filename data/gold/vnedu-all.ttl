vnedu:Alumnus a owl:Class ;
    rdfs:label "Alumnus"@en,
        "Cựu sinh viên"@vi ;
    rdfs:subClassOf vnedu:Person .

vnedu:alumnusOf a owl:ObjectProperty ;
    rdfs:label "alumnus of"@en,
        "cựu sinh viên của"@vi ;
    rdfs:comment "Reserved for documented alumni status; generic education records use educatedAt instead."@en ;
    rdfs:domain vnedu:Person ;
    rdfs:range vnedu:EducationalOrganization ;
    rdfs:subPropertyOf schema:alumniOf ;
    owl:inverseOf vnedu:hasAlumnus .

vnedu:birthAreaInCurrentCrosswalk a owl:ObjectProperty ;
    rdfs:label "birth area in current administrative crosswalk"@en ;
    rdfs:domain vnedu:Person ;
    rdfs:range vnedu:AdministrativeUnit ;
    owl:propertyChainAxiom ( vnedu:bornIn vnedu:mergedInto ),
        ( vnedu:bornIn vnedu:partOf ),
        ( vnedu:birthAreaInCurrentCrosswalk vnedu:partOf ) .

vnedu:dissolutionYear a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dissolution year"@en,
        "năm giải thể / sáp nhập"@vi ;
    rdfs:domain vnedu:Organization ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf dbo:dissolutionYear .

vnedu:governs a owl:ObjectProperty ;
    rdfs:label "governs"@en,
        "là cơ quan chủ quản của"@vi ;
    rdfs:domain vnedu:GoverningBody ;
    rdfs:range vnedu:EducationalOrganization .

vnedu:hasAlumnus a owl:ObjectProperty ;
    rdfs:label "has alumnus"@en,
        "có cựu sinh viên"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:Person .

vnedu:hasBranch a owl:ObjectProperty ;
    rdfs:label "has branch"@en,
        "có phân hiệu"@vi ;
    rdfs:domain vnedu:HigherEducationInstitution ;
    rdfs:range vnedu:Branch ;
    rdfs:subPropertyOf schema:subOrganization .

vnedu:hasEducationParticipant a owl:ObjectProperty ;
    rdfs:label "has recorded education participant"@en ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:Person .

vnedu:hasMember a owl:ObjectProperty ;
    rdfs:label "has member"@en,
        "có đơn vị thành viên"@vi ;
    rdfs:comment "Inverse of vnedu:memberOf; it is not asserted to be schema:subOrganization without separate structural evidence."@en ;
    rdfs:domain vnedu:HigherEducationInstitution ;
    rdfs:range vnedu:EducationalOrganization .

vnedu:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en,
        "gồm"@vi ;
    rdfs:domain vnedu:AdministrativeUnit ;
    rdfs:range vnedu:AdministrativeUnit ;
    rdfs:subPropertyOf schema:containsPlace .

vnedu:leads a owl:ObjectProperty ;
    rdfs:label "leads"@en,
        "đứng đầu"@vi ;
    rdfs:domain vnedu:Person ;
    rdfs:range vnedu:Organization ;
    owl:inverseOf vnedu:hasLeader .

vnedu:mergedFrom a owl:ObjectProperty ;
    rdfs:label "merged from"@en,
        "hình thành từ"@vi ;
    rdfs:domain vnedu:Province ;
    rdfs:range vnedu:FormerProvince .

vnedu:ofMajor a owl:ObjectProperty ;
    rdfs:label "of major"@en,
        "thuộc ngành"@vi ;
    rdfs:domain vnedu:AcademicProgram ;
    rdfs:range vnedu:Major .

vnedu:offeredBy a owl:ObjectProperty ;
    rdfs:label "offered by"@en,
        "do ... đào tạo"@vi ;
    rdfs:domain vnedu:AcademicProgram ;
    rdfs:range vnedu:EducationalOrganization ;
    rdfs:subPropertyOf schema:provider .

vnedu:offersProgram a owl:ObjectProperty ;
    rdfs:label "offers program"@en,
        "đào tạo chương trình"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:AcademicProgram ;
    owl:inverseOf vnedu:offeredBy .

vnedu:subordinateTo a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "subordinate to"@en,
        "trực thuộc (cơ quan cấp trên)"@vi ;
    rdfs:domain vnedu:GoverningBody ;
    rdfs:range vnedu:GoverningBody .

vnedu:successor a owl:ObjectProperty ;
    rdfs:label "successor"@en,
        "đơn vị kế tục"@vi ;
    rdfs:domain vnedu:Organization ;
    rdfs:range vnedu:Organization ;
    rdfs:subPropertyOf dbo:successor .


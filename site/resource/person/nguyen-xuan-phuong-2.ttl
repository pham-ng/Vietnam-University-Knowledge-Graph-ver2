person:nguyen-xuan-phuong-2 a foaf:Person,
        vnedu:InstitutionLeader,
        vnedu:Person,
        schema:Person ;
    rdfs:label "Nguyễn Xuân Phương"@vi ;
    foaf:name "Nguyễn Xuân Phương" ;
    vnedu:honorific "PGS TS" ;

        schema:Organization ;
    rdfs:label "Academy of Public Administration and Governance"@en,
        "Học viện Hành chính và Quản trị công"@vi ;
    dbo:abbreviation "APAG",
        "HVHC&QTC",
        "NAPA" ;
    dbo:abstract "Học viện Hành chính và Quản trị công (tên tiếng Anh: Academy of Public Administration and Governance; APAG) là đơn vị sự nghiệp công lập trực thuộc Học viện Chính trị Quốc gia Hồ Chí Minh, đơn vị chịu sự quản lý của Ban Chấp hành Trung ương Đảng Cộng sản Việt Nam. Học viện có chức năng đào tạo, bồi dưỡng năng lực, kiến thức, kỹ năng cho đội ngũ cán bộ, công chức, viên chức của Đảng & Nhà nước Việt Nam về hành chính, lãnh đạo, quản lý của toàn bộ nền công vụ Việt Nam."@vi ;
    dbo:formerName "Học viện Hành chính"@vi,
        "Học viện Hành chính Quốc gia"@vi,
        "Trường Hành chính"@vi ;
    dbo:foundingYear 1959 ;
    dbo:motto "Trí tuệ - Chất lượng - Hiện đại"@vi ;
    owl:sameAs wd:Q10771885,
        <https://ror.org/02dg2kf02> ;
    geo:lat 21.026251 ;
    geo:long 105.81153 ;
    skos:notation "HCH" ;
    skos:prefLabel "Học viện Hành chính và Quản trị công"@vi ;
    prov:wasDerivedFrom wd:Q10771885,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75599552> ;
    foaf:homepage <https://apag.edu.vn> ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Academy_of_Public_Administration_and_Governance>,
        <https://vi.wikipedia.org/wiki/H%E1%BB%8Dc_vi%E1%BB%87n_H%C3%A0nh_ch%C3%ADnh_v%C3%A0_Qu%E1%BA%A3n_tr%E1%BB%8B_c%C3%B4ng> ;
    vnedu:address "số 77 đường Nguyễn Chí Thanh, phường Láng Thượng, quận Đống Đa, thủ đô Hà Nội, nước Việt Nam" ;
    vnedu:admissionCode "HCH" ;
    vnedu:director person:nguyen-ba-chien-2 ;
    vnedu:formerName "Học viện Hành chính"@vi,
        "Học viện Hành chính Quốc gia"@vi,
        "Trường Hành chính"@vi ;
    vnedu:foundingYear 1959 ;
    vnedu:hasEducationParticipant person:lam-van-doan,
        person:tran-dai-quang,
        person:truong-tan-sang ;
    vnedu:hasLeader person:nguyen-ba-chien-2 ;
    vnedu:history """Học viện Hành chính và Quản trị công tiền thân là Trường Hành chính, được thành lập năm 1959 trực thuộc Bộ Nội vụ, với nhiệm vụ huấn luyện cán bộ chính quyền cấp huyện. Trường đặt tại huyện Từ Sơn, tỉnh Bắc Ninh và khai giảng khóa đầu tiên vào ngày 16 tháng 10 năm 1959.

Năm 1961, trường được đổi tên thành Trường Hành chính Trung ương và chuyển trụ sở về Láng Hạ, Hà Nội. Năm 1980, trường được sáp nhập với Trường Kinh tế Trung ương thành Trường Hành chính – Kinh tế Trung ương; đến năm 1981 được tách trở lại thành Trường Hành chính Trung ương.

Năm 1990, trường đổi tên thành Trường Hành chính Quốc gia; đến năm 1992 đổi tên thành Học viện Hành chính Quốc gia.

Giai đoạn 2007–2013, Học viện trực thuộc Học viện Chính trị Quốc gia Hồ Chí Minh với tên gọi Học viện Hành chính. Từ năm 2013, Học viện trở lại trực thuộc Bộ Nội vụ theo Nghị quyết số 121/NQ-CP.

Năm 2017, Học viện tiếp nhận Trường Đào tạo, bồi dưỡng cán bộ, công chức trực thuộc Bộ Nội vụ. Năm 2022, Trường Đại học Nội vụ Hà Nội được sáp nhập vào Học viện.

Từ năm 2025, Học viện mang tên Học viện Hành chính và Quản trị công và trực thuộc Học viện Chính trị Quốc gia Hồ Chí Minh."""@vi ;

        schema:CollegeOrUniversity,
        schema:EducationalOrganization,
        schema:Organization ;
    rdfs:label "University of Tran Dai Nghia"@en,
        "Trường Đại học Trần Đại Nghĩa"@vi ;
    dbo:abstract "Trường Đại học Trần Đại Nghĩa trực thuộc Tổng cục Hậu cần–Kỹ thuật, Bộ Quốc phòng là một trường đại học kỹ thuật được thành lập ngày 12 tháng 5 năm 1975 trên cơ sở nâng cấp Trường Sĩ quan Kỹ thuật quân sự. Trường đào tạo Sĩ quan kỹ thuật trình độ đại học (Kỹ sư công nghệ kỹ thuật quân sự) cho Quân đội nhân dân Việt Nam và đào tạo kỹ sư dân sự phục vụ nền kinh tế quốc dân Trụ sở chính: 189 Nguyễn Oanh, phường Gò Vấp, Thành phố Hồ Chí Minh. Trang web chính thức: https://tdnu.edu.vn/"@vi ;
    dbo:foundingYear 1975 ;
    dbo:motto "Học đi đôi với hành, Lý luận gắn liền với thực tiễn"@vi ;
    owl:sameAs wd:Q10829151,
        <https://ror.org/05qq5b157> ;
    skos:prefLabel "Trường Đại học Trần Đại Nghĩa"@vi ;
    prov:wasDerivedFrom wd:Q10829151,
        <https://vi.wikipedia.org/w/index.php?oldid=75588629> ;
    foaf:homepage <http://tdnu.edu.vn/> ;
    foaf:isPrimaryTopicOf <https://vi.wikipedia.org/wiki/Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Tr%E1%BA%A7n_%C4%90%E1%BA%A1i_Ngh%C4%A9a> ;
    vnedu:foundingYear 1975 ;
    vnedu:governedBy vnedu:MinistryOfNationalDefence,
        organization:tong-cuc-hau-canky-thuat ;
    vnedu:history "Trường được thành lập ngày 27/5/1978 theo Quyết định số 51/QĐ-QP ngày 27/05/1978 của Bộ Quốc phòng, với tên gọi đầu tiên là \"Trường Hạ sĩ quan Kỹ thuật\", có thêm nhiệm vụ: Đào tạo Hạ sĩ quan Kỹ thuật hệ I, với 11 chuyên ngành. Giai đoạn 1981–1991, theo Quyết định số 51/QĐ-QP ngày 21/02/1981 của Bộ Quốc phòng, Trường được nâng cấp đào tạo từ Hạ sĩ quan Kỹ thuật lên đào tạo Sĩ quan Kỹ thuật; theo Quyết định số 752/QĐ-QP ngày 15/05/1982 của Bộ Quốc phòng, Trường được mang tên \"Trường Sĩ quan Kỹ thuật Vin-hem Pich\". Theo Quyết định số 236/QĐ-QP ngày 06/03/1996 và Quyết định số 115/QĐ-QP ngày 11/02/1997 của Bộ Quốc phòng, Trường mang tên \"Trường CĐKT Vin-hem Pich\". Theo Quyết định số 2165/QĐ-BQP ngày 09/7/2009 của Bộ trưởng Bộ Quốc phòng, Trường mang tên \"Trường Sĩ quan Kỹ thuật quân sự (Vin-hem Pich)\" trực thuộc Tổng cục Kỹ thuật. Ngày 23/12/2010 Phó Thủ tướng Chính phủ Nguyễn Thiện Nhân đã ký Quyết định số 2345/QĐ-TTg thành lập \"Trường Đại học Trần Đại Nghĩa\" trên cơ sở nâng cấp trường Sĩ quan Kỹ thuật quân sự (Vin-hem Pich)."@vi ;
    vnedu:locatedIn country:viet-nam,
        province:thanh-pho-ho-chi-minh,
        region:nam-bo ;
    vnedu:motto "Học đi đôi với hành, Lý luận gắn liền với thực tiễn"@vi ;
    vnedu:ownership vnedu:PublicOwnership ;
    vnedu:reportedGovernedBy organization:tong-cuc-hau-canky-thuat ;
    vnedu:website <http://tdnu.edu.vn/> ;
    schema:location country:viet-nam,
        province:thanh-pho-ho-chi-minh,
        region:nam-bo .

university:truong-dai-hoc-y-duoc-ha-noi a dbo:University,
        foaf:Organization,
        vnedu:DefunctInstitution,

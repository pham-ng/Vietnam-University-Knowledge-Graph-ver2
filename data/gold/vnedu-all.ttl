        "Trường Đại học Y khoa (1994)" ;
    skos:notation "DTY" ;
    skos:prefLabel "Trường Đại học Y Dược, Đại học Thái Nguyên"@vi ;
    prov:wasDerivedFrom wd:Q10829169,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,

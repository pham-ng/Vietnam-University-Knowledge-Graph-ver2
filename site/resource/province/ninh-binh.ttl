province:ninh-binh a vnedu:AdministrativeUnit,
        vnedu:Province,
        schema:AdministrativeArea ;
    rdfs:label "Ninh Bình"@en,
        "Ninh Bình"@vi ;
    owl:sameAs dbr:Ninh_Bình_province,
        wd:Q36900,
        <https://sws.geonames.org/1559970/> ;
    geo:lat 20.25 ;
    geo:long 105.833333333 ;
    prov:wasDerivedFrom wd:Q36900 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Ninh_B%C3%ACnh_province>,
        <https://vi.wikipedia.org/wiki/Ninh_B%C3%ACnh> ;
    vnedu:area 3943.0 ;
    vnedu:mergedFrom province:ha-nam,
        province:nam-dinh ;
    vnedu:partOf country:viet-nam,
        region:bac-bo ;
    vnedu:population "3818700"^^xsd:nonNegativeInteger .


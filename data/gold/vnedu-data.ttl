university:truong-dai-hoc-ton-duc-thang a vnedu:UniversitySchool ;
    rdfs:label "Trường Đại học Tôn Đức Thắng"@vi ;
    dbo:abstract "Trường Đại học Tôn Đức Thắng (TDTU) là một trường đại học công lập của Việt Nam. Trường trực thuộc Tổng Liên đoàn Lao động Việt Nam. Trường hoạt động theo cơ chế tự chủ toàn diện. Trường hiện có các cơ sở tại TP. Hồ Chí Minh, tỉnh Khánh Hòa, tỉnh Lâm Đồng."@vi ;
    geo:lat 10.731944 ;
    geo:long 106.699167 ;
    skos:prefLabel "Trường Đại học Tôn Đức Thắng"@vi ;
    prov:wasDerivedFrom wd:Q1457082,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75337914> ;
    vnedu:address "19 Nguyễn Hữu Thọ, phường Tân Hưng, TP. Hồ Chí Minh" ;
    vnedu:admissionCode "DTT" ;
    vnedu:foundingYear 1997 ;
    vnedu:history """Tiền thân của Trường Đại học Tôn Đức Thắng là Trường Đại học Công nghệ Dân lập Tôn Đức Thắng, được thành lập theo quyết định 787/TTg ngày 24/9/1997 của Thủ tướng Chính phủ. Trường do Liên đoàn lao động Thành phố Hồ Chí Minh sáng lập và quản lý thông qua Hội đồng quản trị do Chủ tịch Liên đoàn Lao động Thành phố đương nhiệm làm Chủ tịch.

Ngày 28/01/2003, Thủ tướng Chính phủ ra Quyết định số 18/2003/QĐ-TTg chuyển đổi pháp nhân và đổi tên Trường Đại học Công nghệ Dân lập Tôn Đức Thắng thành Trường Đại học Bán công Tôn Đức Thắng trực thuộc Ủy ban nhân dân Thành phố Hồ Chí Minh.

Ngày 11/6/2008, Thủ tướng Chính phủ ra Quyết định số 747/QĐ-TTg đổi tên Trường Đại học Bán công Tôn Đức Thắng thành Trường Đại học Tôn Đức Thắng và chuyển về thuộc Tổng Liên đoàn Lao động Việt Nam."""@vi ;
    vnedu:locatedIn province:thanh-pho-ho-chi-minh ;
    vnedu:ownership vnedu:PublicOwnership ;
    vnedu:rector person:tran-trong-dao ;
    vnedu:reportedGovernedBy organization:tong-lien-doan-lao-dong-viet-nam ;

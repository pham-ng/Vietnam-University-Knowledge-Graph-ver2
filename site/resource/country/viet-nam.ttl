@prefix country: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/country/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix province: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/province/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix region: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/region/> .
@prefix schema: <https://schema.org/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .

country:viet-nam a vnedu:AdministrativeUnit,
        vnedu:Country,
        schema:AdministrativeArea,
        schema:Country ;
    rdfs:label "Vietnam"@en,
        "Việt Nam"@vi ;
    owl:sameAs dbr:Vietnam,
        wd:Q881 ;
    vnedu:hasPart province:an-giang,
        province:bac-ninh,
        province:ca-mau,
        province:can-tho,
        province:cao-bang,
        province:da-nang,
        province:dak-lak,
        province:dien-bien,
        province:dong-nai,
        province:dong-thap,
        province:gia-lai,
        province:ha-noi,
        province:ha-tinh,
        province:hai-phong,
        province:hue,
        province:hung-yen,
        province:khanh-hoa,
        province:lai-chau,
        province:lam-dong,
        province:lang-son,
        province:lao-cai,
        province:nghe-an,
        province:ninh-binh,
        province:phu-tho,
        province:quang-ngai,
        province:quang-ninh,
        province:quang-tri,
        province:son-la,
        province:tay-ninh,
        province:thai-nguyen,
        province:thanh-hoa,
        province:thanh-pho-ho-chi-minh,
        province:tuyen-quang,
        province:vinh-long,
        region:bac-bo,
        region:nam-bo,
        region:trung-bo .


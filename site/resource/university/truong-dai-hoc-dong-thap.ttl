    vnedu:address "783 Phạm Hữu Lầu, Phường Cao Lãnh" ;
    vnedu:foundingYear "2003"^^xsd:gYear ;
    vnedu:governedBy organization:bo-giao-duc-va-dao-tao ;
    vnedu:hasAlumnus person:danh-duc-ha,
        person:phan-thanh-dat ;
    vnedu:hasLeader person:truong-tan-dat ;
    vnedu:history """Trường Đại học Đồng Tháp tiền thân là Trường Cao đẳng Sư phạm Đồng Tháp, ngày 10 tháng 1 năm 2003, Phó Thủ tướng Chính phủ Phạm Gia Khiêm đã ký Quyết định số 08/2003/QĐ – TTg, nâng cấp thành Trường Đại học Sư phạm Đồng Tháp.

Đến ngày 4 tháng 9 năm 2008, Phó Thủ tướng Chính phủ Nguyễn Thiện Nhân đã đồng ý cho phép đổi tên Trường Đại học Sư phạm Đồng Tháp thành Trường Đại học Đồng Tháp."""@vi ;

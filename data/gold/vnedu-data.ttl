        "HCMUP" ;
    schema:foundingDate "1976-10-27T00:00:00"^^xsd:dateTime ;
    schema:image <https://upload.wikimedia.org/wikipedia/commons/8/82/A_SP_HCMUE.jpg> ;
    schema:logo <https://upload.wikimedia.org/wikipedia/vi/9/9e/Logo_Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_S%C6%B0_ph%E1%BA%A1m_Th%C3%A0nh_ph%E1%BB%91_H%E1%BB%93_Ch%C3%AD_Minh.svg> ;

@prefix country: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/country/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix province: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/province/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix region: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/region/> .
@prefix schema: <https://schema.org/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .

region:bac-bo a vnedu:AdministrativeUnit,
        vnedu:Region,
        schema:AdministrativeArea ;
    rdfs:label "Northern Vietnam"@en,
        "Bắc Bộ"@vi ;
    owl:sameAs dbr:Northern_Vietnam,
        wd:Q2428694 ;
    vnedu:hasPart province:bac-ninh,
        province:cao-bang,
        province:dien-bien,
        province:ha-noi,
        province:hai-phong,
        province:hung-yen,
        province:lai-chau,
        province:lang-son,
        province:lao-cai,
        province:ninh-binh,
        province:phu-tho,
        province:quang-ninh,
        province:son-la,
        province:thai-nguyen,
        province:tuyen-quang ;
    vnedu:partOf country:viet-nam .


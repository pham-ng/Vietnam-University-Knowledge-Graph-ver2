@prefix country: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/country/> .
@prefix dbr: <http://dbpedia.org/resource/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix province: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/province/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix region: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/region/> .
@prefix schema: <https://schema.org/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .

region:trung-bo a vnedu:AdministrativeUnit,
        vnedu:Region,
        schema:AdministrativeArea ;
    rdfs:label "Central Vietnam"@en,
        "Trung Bộ"@vi ;
    owl:sameAs dbr:Central_Vietnam,
        wd:Q1863140 ;
    vnedu:hasPart province:da-nang,
        province:dak-lak,
        province:gia-lai,
        province:ha-tinh,
        province:hue,
        province:khanh-hoa,
        province:lam-dong,
        province:nghe-an,
        province:quang-ngai,
        province:quang-tri,
        province:thanh-hoa ;
    vnedu:partOf country:viet-nam .


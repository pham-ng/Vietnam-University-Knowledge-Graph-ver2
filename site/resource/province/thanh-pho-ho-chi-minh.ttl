@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

province:thanh-pho-ho-chi-minh a vnedu:AdministrativeUnit,
        vnedu:CentrallyGovernedCity,
        vnedu:Province,
        schema:AdministrativeArea ;
    rdfs:label "Ho Chi Minh City"@en,
        "Thành phố Hồ Chí Minh"@vi ;
    owl:sameAs dbr:Ho_Chi_Minh_City,
        wd:Q1854,
        <https://sws.geonames.org/1566083/> ;
    geo:lat 10.775555555 ;
    geo:long 106.701944444 ;
    prov:wasDerivedFrom wd:Q1854 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Ho_Chi_Minh_City>,
        <https://vi.wikipedia.org/wiki/Th%C3%A0nh_ph%E1%BB%91_H%E1%BB%93_Ch%C3%AD_Minh> ;
    vnedu:area 6772.59 ;
    vnedu:mergedFrom province:ba-ria-vung-tau,
        province:binh-duong ;
    vnedu:partOf country:viet-nam,
        region:nam-bo ;
    vnedu:population "14002598"^^xsd:nonNegativeInteger .


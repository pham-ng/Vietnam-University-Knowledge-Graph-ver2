        province:hue,
        region:trung-bo ;
    schema:logo <https://upload.wikimedia.org/wikipedia/vi/3/33/Logo_Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Khoa_h%E1%BB%8Dc%2C_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Hu%E1%BA%BF.svg> ;
    schema:telephone "(0234)3823290" .

university:truong-dai-hoc-khoa-hoc-dai-hoc-thai-nguyen a dbo:University,

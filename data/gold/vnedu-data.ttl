    schema:telephone "0225 3876 338" .

university:truong-dai-hoc-kiem-sat a vnedu:UniversitySchool ;
    rdfs:label "Hanoi Procuratorate University"@en,
        "Trường Đại học Kiểm sát"@vi ;
    dbo:abstract "Trường Đại học Kiểm sát là cơ sở giáo dục đại học công lập trong hệ thống giáo dục quốc dân Việt Nam, trực thuộc Viện Kiểm sát Nhân dân tối cao. Hiện tại, trường đào tạo 4 ngành đại học là Luật Kiểm sát, Luật chung, Luật kinh tế và Ngôn ngữ Anh; hai ngành sau đại học là Luật và Luật hình sự và tố tụng hình sự."@vi ;
    skos:altLabel "VPU, Vietnam Procuratorate University" ;
    skos:prefLabel "Trường Đại học Kiểm sát"@vi ;
    prov:wasDerivedFrom wd:Q18415683,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75381895> ;
    vnedu:address "Số 59, Ngõ 230, Phố Ỷ La, phường Dương Nội, thành phố Hà Nội" ;
    vnedu:admissionCode "DKS" ;
    vnedu:foundingYear 2013 ;
    vnedu:history """Ngày 21/4/1970, Viện trưởng Viện Kiểm sát Nhân dân Tối cao đã ký Quyết định số 62/QĐ-TC về tổ chức bộ máy của VKSND tối cao, trong đó có Trường Bổ túc và đào tạo cán bộ kiểm sát (Ngày 12/10/1964 đồng chí Hoàng Quốc Việt đã ký Quyết định thành lập Trường Cán bộ kiểm sát trực thuộc Viện kiểm sát nhân dân tối cao). Quyết định này được Ủy ban Thường vụ Quốc hội phê chuẩn tại Nghị quyết số 900/NQ-UBTVQH ngày 25/4/1970, ngày 25/4 hàng năm được coi là ngày truyền thống của Trường.

Có thể chia quá trình xây dựng và phát triển của trường thành 4 giai đoạn:

Giai đoạn thứ nhất: Tổ chức và hoạt động của Trường Bổ túc và đào tạo cán bộ kiểm sát (1970-1981). Giai đoạn thứ hai: Tổ chức và hoạt động của Trường Cao đẳng kiểm sát (1982-2005). Giai đoạn thứ ba: Tổ chức và hoạt động của Trường Đào tạo, bồi dưỡng nghiệp vụ kiểm sát (từ năm 2005 - 4/2013). Giai đoạn thứ tư: Tổ chức và hoạt động của Trường Đại học Kiểm sát Hà Nội.

Ngày 24/04/2013, Thủ tướng Chính phủ đã ký Quyết định số 614/QĐ-TTg về việc thành lập Trường Đại học Kiểm sát Hà Nội trên cơ sở nâng cấp Trường Đào tạo, bồi dưỡng nghiệp vụ kiểm sát.

Ngày 07/02/2025, Viện trưởng VKSND tối cao đã ban hành Quyết định số 01 trong đó sáp nhập trường Đại học Kiểm sát Hà Nội với trường Bồi dưỡng nghiệp vụ Kiểm sát, lấy tên là trường Đại học Kiểm sát."""@vi ;
    vnedu:locatedIn province:ha-noi ;
    vnedu:motto "Trí tuệ, bản lĩnh, nhân ái, công tâm, trách nhiệm"@vi ;
    vnedu:numberOfStudents "1500"^^xsd:nonNegativeInteger ;
    vnedu:ownership vnedu:PublicOwnership ;
    vnedu:rector person:nguyen-van-khoat ;
    vnedu:website <https://hpu.vn> ;
    schema:email "phongdaotao.dhkshn@gmail.com" ;
    schema:logo <https://upload.wikimedia.org/wikipedia/vi/2/25/Ph%C3%B9_hi%E1%BB%87u_Tr%C6%B0%E1%BB%9Dng_%C4%90HKS_H%C3%A0_N%E1%BB%99i.svg> ;
    schema:telephone "024 3358 1280 – 024 3387 8340" .

university:truong-dai-hoc-kinh-doanh-va-cong-nghe-ha-noi a vnedu:UniversitySchool ;
    rdfs:label "Hanoi University of Business and Technology"@en,
        "Trường Đại học Kinh doanh và Công nghệ Hà Nội"@vi ;
    dbo:abstract "Trường Đại học Kinh doanh và Công nghệ Hà Nội (tiếng Anh: Hanoi University of Business and Technology, viết tắt HUBT) là một cơ sở đào tạo giáo dục tư thục tại Việt Nam, được thành lập theo Quyết định số 405/TTg ngày 14 tháng 6 năm 1996 của Thủ tướng Chính phủ tại Hà Nội."@vi ;
    skos:prefLabel "Trường Đại học Kinh doanh và Công nghệ Hà Nội"@vi ;
    prov:wasDerivedFrom wd:Q10829067,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75576334> ;
    vnedu:address "Số 29A, ngõ 124 phố Vĩnh Tuy, phường Vĩnh Tuy, thành phố Hà Nội" ;
    vnedu:admissionCode "DQK" ;
    vnedu:foundingYear 1996 ;
    vnedu:history """Khi mới thành lập vào tháng 6 năm 1996, trường có tên là Trường Đại học dân lập Quản lý và Kinh doanh Hà Nội và do Giáo sư Trần Phương (Chủ tịch Hội Khoa học kinh tế Việt Nam, nguyên Phó Chủ tịch Hội đồng Bộ trưởng) làm hiệu trưởng. Do mở rộng mục tiêu đào tạo sang lĩnh vực kỹ thuật - công nghệ, trường được đổi tên thành Trường Đại học Kinh doanh và Công nghệ Hà Nội kể từ tháng 5 năm 2006, sau đó trường bỏ tên dân lập. Trường nằm trong hệ thống giáo dục quốc dân.

Nhưng đến ngày 3/6/2019, Thủ tướng Chính phủ đã có Quyết định về việc chuyển đổi Trường Đại học Kinh doanh và Công nghệ Hà Nội sang loại hình trường đại học tư thục. Theo quyết định, HUBT phải tiến hành các bước chuyển đổi từ mô hình dân lập sang tư thục. Để thực hiện việc này, trường bắt buộc phải thành lập Hội đồng trường (HĐT). Nhưng trong suốt hơn 7 năm qua đến nay năm 2026, dù Bộ Giáo dục và Đào tạo , cơ quan quản lý nhiều lần có văn bản đôn đốc, trường HUBT vẫn chưa thể thành lập Hội đồng trường ."""@vi ;
    vnedu:locatedIn province:ha-noi ;
    vnedu:ownership vnedu:PrivateOwnership ;
    vnedu:website <https://hubt.edu.vn> ;
    schema:email "tndunghubt@gmail.com" ;
    schema:foundingDate "1996-06-14T00:00:00"^^xsd:dateTime ;
    schema:image <https://upload.wikimedia.org/wikipedia/commons/1/19/HUBT_2023.jpg> ;
    schema:logo <https://upload.wikimedia.org/wikipedia/vi/6/65/Logo_HUBT.jpg> ;
    schema:telephone "0243 6336507" .

university:truong-dai-hoc-kinh-te-tai-chinh-thanh-pho-ho-chi-minh a vnedu:UniversitySchool ;
    rdfs:label "Ho Chi Minh City University of"@en,
        "Trường Đại học Kinh tế – Tài chính Thành phố Hồ Chí Minh"@vi ;
    dbo:abstract "Trường Đại học Kinh tế - Tài chính thành phố Hồ Chí Minh (, viết tắt: UEF) là một đại học tư thục tại Việt Nam, được thành lập theo quyết định số 1272/QĐ-TTg ngày 24 tháng 9 năm 2007 của Thủ tướng Chính phủ Nguyễn Tấn Dũng. Vào năm 2014, sau 8 năm hoạt động gắng gượng, các nhà đầu tư của trường Đại học Kinh tế - Tài chính thành phố Hồ Chí Minh đã bán lại trường cho chủ thương hiệu Đại học HUTECH Kiều Xuân Hùng với giá gần 200 tỷ đồng."@vi ;
    geo:lat 10.798702 ;
    geo:long 106.723092 ;
    skos:prefLabel "Trường Đại học Kinh tế – Tài chính Thành phố Hồ Chí Minh"@vi ;
    prov:wasDerivedFrom wd:Q10829074,
        <https://api.ror.org/v2/organizations>,
        <https://vi.wikipedia.org/w/index.php?oldid=74954564> ;
    vnedu:address "Số 276 Điện Biên Phủ, phường Gia Định, Thành phố Hồ Chí Minh" ;
    vnedu:admissionCode "UEF" ;
    vnedu:campus "10.000m2 tại Trụ sở 276 Điện Biên Phủ" ;
    vnedu:foundingYear 2007 ;
    vnedu:history """Trường Đại học Kinh tế – Tài chính Thành phố Hồ Chí Minh được thành lập vào ngày 24 tháng 9 năm 2007 theo quyết định số 1272/QĐ-TTg của Thủ tướng Chính phủ Nguyễn Tấn Dũng. Trường được hoạt động với phương châm "Chất lượng - Hiệu quả - Hội nhập".

Năm 2014, sau 8 năm gắng gượng trường đã được bán cho Công ty cổ phần Đầu tư phát triển giáo dục HUTECH, Kiều Xuân Hùng, với giá gần 200 tỷ đồng. Bấy giờ, giá học phí của trường lên tới gần 80 triệu đồng / một năm nên trước khi thay tên đổi chủ, việc tuyển sinh của trường lúc nào cũng chưa đạt múc 50% chỉ tiêu."""@vi ;
    vnedu:locatedIn province:thanh-pho-ho-chi-minh ;
    vnedu:motto "Chất lượng - Hiệu quả - Hội nhập"@vi ;

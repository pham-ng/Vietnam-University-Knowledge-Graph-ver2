    rdfs:label "Ho Chi Minh Cadre Academy"@en,
        "Học viện Cán bộ Thành phố Hồ Chí Minh"@vi ;
    dbo:abstract "Học viện Cán bộ Thành phố Hồ Chí Minh (, viết tắt: HCA) là một cơ sở giáo dục bậc đại học công lập và trường chính trị trực thuộc Thành ủy Thành phố Hồ Chí Minh. Trường có trụ sở chính tại số 324, đường Chu Văn An, phường Bình Thạnh, thành phố Hồ Chí Minh."@vi ;
    geo:lat 10.812578 ;

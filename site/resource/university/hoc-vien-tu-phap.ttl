    rdfs:label "Judicial Academy"@en,
        "Học viện Tư pháp"@vi ;
    dbo:abstract "Học viện Tư pháp Việt Nam là cơ sở đào tạo và nghiên cứu khoa học cấp đại học tại Việt Nam, chuyên ngành đào tạo, bồi dưỡng các chức danh tư pháp tại Việt Nam."@vi ;

province:ha-noi a vnedu:AdministrativeUnit,
        vnedu:CentrallyGovernedCity,
        vnedu:Province,
        schema:AdministrativeArea ;
    rdfs:label "Hanoi"@en,
        "Hà Nội"@vi ;
    owl:sameAs dbr:Hanoi,
        wd:Q1858,
        <https://sws.geonames.org/1581130/> ;
    geo:lat 21.0245 ;
    geo:long 105.84117 ;
    prov:wasDerivedFrom wd:Q1858 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Hanoi>,
        <https://vi.wikipedia.org/wiki/H%C3%A0_N%E1%BB%99i> ;
    vnedu:area 3359.84 ;
    vnedu:partOf country:viet-nam,
        region:bac-bo ;
    vnedu:population "8717600"^^xsd:nonNegativeInteger .


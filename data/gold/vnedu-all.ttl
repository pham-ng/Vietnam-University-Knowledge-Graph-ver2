    vnedu:hasEducationParticipant person:cao-manh-linh,
        person:dang-ngoc-huy,
        person:do-duc-hieu,
        person:do-thi-viet-ha,
        person:do-van-dai,
        person:doan-anh-dung,
        person:dong-ngoc-ba,
        person:hoang-minh-hieu,
        person:lai-the-nguyen,
        person:le-thanh-hoan,
        person:le-thi-thu-hang,
        person:nguyen-cong-long,

    foaf:homepage <https://www.dav.edu.vn/> ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Diplomatic_Academy_of_Vietnam>,
        <https://vi.wikipedia.org/wiki/H%E1%BB%8Dc_vi%E1%BB%87n_Ngo%E1%BA%A1i_giao_%28Vi%E1%BB%87t_Nam%29> ;

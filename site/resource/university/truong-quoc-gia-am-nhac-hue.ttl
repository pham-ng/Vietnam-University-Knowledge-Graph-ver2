university:truong-quoc-gia-am-nhac-hue a foaf:Organization,
        vnedu:DefunctInstitution,
        vnedu:EducationalOrganization,
        vnedu:HigherEducationInstitution,
        vnedu:Organization,
        schema:CollegeOrUniversity,
        schema:EducationalOrganization,
        schema:Organization ;
    rdfs:label "Trường Quốc gia Âm nhạc Huế"@vi ;
    dbo:abstract "Trường Quốc gia Âm nhạc Huế là một cơ sở giáo dục chuyên về âm nhạc nhất là nhạc truyền thống Việt Nam. Trường hoạt động từ năm 1962 đến năm 1975 thì giải thể."@vi ;
    owl:sameAs wd:Q16480497 ;
    skos:prefLabel "Trường Quốc gia Âm nhạc Huế"@vi ;
    prov:wasDerivedFrom wd:Q16480497,
        <https://vi.wikipedia.org/w/index.php?oldid=72956482> ;
    foaf:isPrimaryTopicOf <https://vi.wikipedia.org/wiki/Tr%C6%B0%E1%BB%9Dng_Qu%E1%BB%91c_gia_%C3%82m_nh%E1%BA%A1c_Hu%E1%BA%BF> ;
    vnedu:dissolutionYear "1975"^^xsd:gYear ;
    vnedu:foundingYear "1962"^^xsd:gYear ;
    vnedu:history """Địa điểm của Trường là nhà hát Duyệt Thị Đường trong Đại Nội, Huế.

Các giáo sư danh tiếng từng giảng dạy ở cơ sở này gồm có Trần Kích (nhã nhạc), Nguyễn Hữu Ba, Nguyễn Kế (ca Huế). Sinh viên do Trường đào tạo có những người thành tài như nhạc sĩ Hoàng Ngọc Quỳnh, Trần Quang Lộc.

Văn Giảng: nhạc sĩ Nguyễn Hữu Ba: nhạc sĩ Trần Nhật Hiền

Nhạc sĩ Trần Quang Lộc Nhạc sĩ Lô Thanh Giáo sư Otto Söllner, Sau cuộc Tổng công kích Tết Mậu Thân 1968, Söllner rời Việt Nam và định cư ở Freilassing."""@vi ;
    vnedu:locatedIn country:viet-nam,
        province:hue,
        region:trung-bo ;
    schema:location country:viet-nam,
        province:hue,
        region:trung-bo .


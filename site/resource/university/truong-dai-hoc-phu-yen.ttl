    rdfs:label "Phu Yen University"@en,
        "Trường Đại học Phú Yên"@vi ;
    dbo:abstract "Trường Đại học Phú Yên (tiếng Anh: Phu Yen University) là một trường đại học địa phương, đào tạo đa ngành của tỉnh Đắk Lắk. Trường Đại học Phú Yên trực thuộc UBND tỉnh Đắk Lắk và chịu sự quản lý nhà nước về đào tạo của Bộ Giáo dục và Đào tạo. Trường có địa chỉ tại: số 01 Nguyễn Văn Huyên, phường Tuy Hòa, tỉnh Đắk Lắk."@vi ;
    owl:sameAs wd:Q10829111,
        <https://ror.org/0589qa052> ;

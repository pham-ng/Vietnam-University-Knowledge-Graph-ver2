        schema:Organization ;
    rdfs:label "Haiphong University of Medicine and Pharmacy"@en,
        "Trường Đại học Y Dược Hải Phòng"@vi ;
    dbo:abstract "Trường Đại học Y Dược Hải Phòng (tiếng Anh: Haiphong University Of Medicine and Pharmacy) là một trường đại học chuyên ngành y khoa tại Việt Nam. Có sứ mạng Đào tạo nguồn nhân lực y tế uy tín, chất lượng; là trung tâm nghiên cứu khoa học, chuyển giao công nghệ; cung cấp dịch vụ chăm sóc sức khỏe và chú trọng phát triển y dược biển đảo Việt Nam. Được xếp vào nhóm các trường đại học trọng điểm đào tạo nhân lực y tế của Việt Nam, trực thuộc Bộ Y tế."@vi ;
    owl:sameAs wd:Q10829172 ;
    skos:prefLabel "Trường Đại học Y Dược Hải Phòng"@vi ;
    prov:wasDerivedFrom wd:Q10829172,
        <https://vi.wikipedia.org/w/index.php?oldid=75085579> ;
    foaf:homepage <http://www.hpmu.edu.vn> ;
    foaf:isPrimaryTopicOf <https://vi.wikipedia.org/wiki/Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_Y_D%C6%B0%E1%BB%A3c_H%E1%BA%A3i_Ph%C3%B2ng> ;
    vnedu:academicStaff "762"^^xsd:nonNegativeInteger ;
    vnedu:address "72A, đường Nguyễn Bỉnh Khiêm, quận Ngô Quyền, Thành phố Hải Phòng, Việt Nam" ;
    vnedu:foundingYear "1979"^^xsd:gYear ;
    vnedu:hasLeader person:nguyen-van-khai ;
    vnedu:history """Trường Đại học Y Dược Hải Phòng có lịch sử gần 40 năm xây dựng phát triển và trưởng thành, bao gồm các mốc chính sau:

Trước năm 1979: Các bệnh viện ở Hải Phòng là cơ sở thực hành của sinh viên Trường đại học Y Hà Nội.

Năm 1979: Chính thức thành lập Cơ sở II của Trường Đại học Y Hà Nội tại Hải Phòng (từ tháng 9/1979 đến 8/1985).

Ngày 17/8/1985, Bộ trưởng Bộ Y tế quyết định (số 843/BYT-QĐ) thành lập Phân hiệu Đại học Y Hải Phòng trực thuộc Trường Đại học Y Hà Nội.

Ngày 25/01/1999, Thủ tướng Chính phủ ký quyết định số 06/1999/QĐ-TTg về việc thành lập Trường Đại học Y Hải Phòng trực thuộc Bộ Y tế, trên cơ sở Phân hiệu Đại học Y Hải Phòng.

Năm 2013, Thủ tướng Chính phủ quyết định đổi tên Trường đại học Y Hải Phòng thành Trường Đại học Y Dược Hải Phòng với nhiệm vụ đào tạo, nghiên cứu và dịch vụ về lĩnh vực sức khỏe, đóng góp trực tiếp cho nhiệm vụ bảo vệ và chăm sóc sức khỏe nhân dân."""@vi ;
    vnedu:locatedIn country:viet-nam,
        province:hai-phong,
        region:bac-bo ;
    vnedu:motto "Tòa nhà Hiệu bộ Đại học Y Dược Hải Phòng"@vi ;

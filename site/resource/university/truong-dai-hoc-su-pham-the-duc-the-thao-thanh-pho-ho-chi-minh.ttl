    foaf:homepage <http://www.upes.edu.vn> ;
    foaf:isPrimaryTopicOf <https://vi.wikipedia.org/wiki/Tr%C6%B0%E1%BB%9Dng_%C4%90%E1%BA%A1i_h%E1%BB%8Dc_S%C6%B0_ph%E1%BA%A1m_Th%E1%BB%83_d%E1%BB%A5c_Th%E1%BB%83_thao_Th%C3%A0nh_ph%E1%BB%91_H%E1%BB%93_Ch%C3%AD_Minh> ;
    vnedu:address "639 Nguyễn Trãi, Phường Chợ Lớn, Thành phố Hồ Chí Minh, Việt Nam" ;

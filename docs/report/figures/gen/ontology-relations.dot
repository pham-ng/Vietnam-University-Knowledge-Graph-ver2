digraph G {
  graph [fontname="DejaVu Sans", rankdir=TB, nodesep=0.45, ranksep=0.8, bgcolor="white", pad=0.2];
  node [fontname="DejaVu Sans", fontsize=11, height=0.32, margin="0.12,0.05"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#8C939C", arrowsize=0.7];

  "AcademicProgram" [label="AcademicProgram", shape=box, style="rounded,filled", fillcolor="#E2F1EE", color="#0F6E64", penwidth=1.6];

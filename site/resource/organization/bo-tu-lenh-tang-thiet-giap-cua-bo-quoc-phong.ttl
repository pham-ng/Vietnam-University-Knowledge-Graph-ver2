@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix organization: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/organization/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix university: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/university/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .

organization:bo-tu-lenh-tang-thiet-giap-cua-bo-quoc-phong a foaf:Organization,
        vnedu:GoverningBody,
        vnedu:Organization,
        schema:GovernmentOrganization,
        schema:Organization ;
    rdfs:label "Bộ Tư lệnh Tăng - Thiết giáp của Bộ Quốc phòng"@vi ;
    vnedu:governs university:truong-si-quan-tang-thiet-giap ;
    vnedu:subordinateTo vnedu:MinistryOfNationalDefence .


@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix organization: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/organization/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix university: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/resource/university/> .
@prefix vnedu: <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .

organization:ubnd-tinh-vinh-long a foaf:Organization,
        vnedu:GoverningBody,
        vnedu:Organization,
        vnedu:ProvincialPeoplesCommittee,
        schema:GovernmentOrganization,
        schema:Organization ;
    rdfs:label "UBND tỉnh Vĩnh Long"@vi ;
    vnedu:governs university:dai-hoc-tra-vinh .


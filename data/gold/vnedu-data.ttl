university:dai-hoc-phenikaa a vnedu:University ;
    rdfs:label "Phenikaa University"@en,
        "Đại học Phenikaa"@vi ;
    dbo:abstract "Đại học Phenikaa (tiếng Anh: Phenikaa University) là một đại học tư thục đào tạo đa ngành tại Hà Nội. Đây là đại học thuộc Tập đoàn Phenikaa và là đại học thứ 10 của Việt Nam."@vi ;
    geo:lat 20.961242 ;
    geo:long 105.747473 ;
    skos:prefLabel "Đại học Phenikaa"@vi ;
    prov:wasDerivedFrom wd:Q107518125,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75437043> ;
    vnedu:address "Đường Nguyễn Trác - Phường Dương Nội" ;
    vnedu:admissionCode "PKA" ;
    vnedu:director person:le-anh-son ;
    vnedu:foundingYear 2007 ;
    vnedu:history """Trường được thành lập ngày 10 tháng 10 năm 2007 theo Quyết định số 1368/QĐ-TTg do Thủ tướng Nguyễn Tấn Dũng ký với tên gọi Trường Đại học Thành Tây.

Năm 2017 trường được Tập đoàn Phenikaa của GS.TS Hồ Xuân Năng mua lại, đổi tên năm 2018.

Ngày 26 tháng 11 năm 2019, Công ty Cổ phần Tập đoàn Phượng Hoàng Xanh A&A (Tập đoàn Phenikaa) chính thức ra mắt Trường Đại học Phenikaa.

Ngày 15 tháng 4 năm 2025 theo Quyết định số 775/QĐ-TTg của Thủ tướng Chính phủ, trường được chuyển đổi mô hình trở thành Đại học Phenikaa, đại học thứ 10 của Việt Nam và đại học tư thục đầu tiên của miền Bắc."""@vi ;
    vnedu:locatedIn province:ha-noi ;
    vnedu:ownedBy organization:tap-doan-phenikaa ;
    vnedu:ownership vnedu:PrivateOwnership ;
    vnedu:shortName "PKA" ;
    vnedu:website <https://phenikaa-uni.edu.vn> ;
    schema:email "info@phenikaa-uni.edu.vn" ;
    schema:telephone "02462918118" .

university:hoc-vien-am-nhac-hue a vnedu:Academy ;
    rdfs:label "Hue Academy of Music"@en,
        "Học viện Âm nhạc Huế"@vi ;
    dbo:abstract "Học viện Âm nhạc Huế là một học viện chuyên ngành chuyên đào tạo và nghiên cứu nhóm ngành âm nhạc, được thành lập vào ngày 8 tháng 11 năm 2007, trụ sở chính của trường được đặt tại phường Thuận Hóa, thành phố Huế. Đây là một trong ba trường đào tạo âm nhạc bậc đại học tại Việt Nam (gồm có Nhạc viện thành phố Hồ Chí Minh và Học viện Âm nhạc Quốc gia Việt Nam). Học viện Âm nhạc Huế tiền thân là Trường Quốc gia Âm nhạc Huế (1962-1975). Từ sau năm 1975, trường đổi tên thành Trường Âm nhạc Huế. Năm 1985, sáp nhập với Trường Cao đẳng Mỹ thuật Huế trở thành Trường Cao đẳng Nghệ thuật Huế. Năm 1994, nâng cấp thành Trường Đại học Nghệ thuật Huế. Các chuyên ngành đào tạo của Học viện bao gồm: Sáng tác âm nhạc, Chỉ huy âm nhạc, Biểu diễn âm nhạc, Nhã nhạc Cung đình Huế...Nhiệm vụ chính của nhà trường là nghiên cứu và đào tạo âm nhạc ở khu vực miền Trung - Tây Nguyên, đồng thời góp phần khôi phục bảo tồn, phát huy giá trị Nhã nhạc Cung đình Huế và Cồng chiêng Tây Nguyên, hai loại hình nghệ thuật đã được UNESCO công nhận là di sản phi vật thể và truyền khẩu của nhân loại. Học viện được đặt trên khu vực của Trường Pellerin Huế, kế thừa tòa nhà cũ của trường này. Đây là một trong những kiến trúc phương Tây còn sót lại của Huế."@vi ;
    geo:lat 16.458611 ;
    geo:long 107.577861 ;
    skos:prefLabel "Học viện Âm nhạc Huế"@vi ;
    prov:wasDerivedFrom wd:Q10771910,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75533100> ;
    vnedu:address "Số 1, đường Lê Lợi, phường Thuận Hóa" ;
    vnedu:admissionCode "HVA" ;
    vnedu:director person:ha-mai-huong ;
    vnedu:foundingYear 2007 ;
    vnedu:history "Học viện Âm nhạc Huế được thành lập ngày 08/11/2007 theo quyết định số 1492/QĐ -TTg của Thủ tướng Chính phủ Nguyễn Tấn Dũng trên cơ sở nâng cấp và tổ chức lại khoa Âm nhạc của trường Đại học Nghệ thuật thuộc Đại học Huế, khoa Âm nhạc thuộc trường Trung học Văn hóa Nghệ thuật Thừa Thiên Huế."@vi ;

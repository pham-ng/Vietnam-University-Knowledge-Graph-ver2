        <https://vi.wikipedia.org/wiki/H%E1%BB%8Dc_vi%E1%BB%87n_H%E1%BA%A3i_qu%C3%A2n_%28Vi%E1%BB%87t_Nam%29> ;
    vnedu:address "30, đường Trần Phú, phường Nha Trang, tỉnh Khánh Hòa" ;

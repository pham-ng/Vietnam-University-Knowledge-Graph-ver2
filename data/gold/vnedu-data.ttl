university:truong-dai-hoc-san-khau-dien-anh-ha-noi a vnedu:UniversitySchool ;
    rdfs:label "Hanoi Academy of Theater and Cinema"@en,
        "Trường Đại học Sân khấu – Điện ảnh Hà Nội"@vi ;
    dbo:abstract "Trường Đại học Sân khấu và Điện ảnh Hà Nội là một trường đại học được thành lập ngày 17 tháng 12 năm 1980, trụ sở của trường được đặt tại phường Mai Dịch, quận Cầu Giấy, thành phố Hà Nội. Trường là một trong những đại học lâu đời ở Việt Nam, chịu trách nhiệm trong việc đào tạo và bồi dưỡng những học viên có năng khiếu trong các lĩnh vực như: Sáng tác (nhạc, văn học), Biểu diễn, Nghiên cứu, Lý luận - Phê bình, Kinh tế - Kỹ thuật và Công nghệ của các ngành nghệ thuật Sân khấu, Điện ảnh và Truyền hình."@vi ;
    skos:prefLabel "Trường Đại học Sân khấu – Điện ảnh Hà Nội"@vi ;
    prov:wasDerivedFrom wd:Q10829124,
        <https://api.ror.org/v2/organizations>,
        <https://tuyensinh.moet.gov.vn/ts/>,
        <https://vi.wikipedia.org/w/index.php?oldid=75556066> ;
    vnedu:address "Khu văn hóa nghệ thuật, Phường Mai Dịch, quận Cầu Giấy, Thành phố Hà Nội, Việt Nam" ;
    vnedu:admissionCode "SKD" ;
    vnedu:foundingYear 1980 ;
    vnedu:history "Trường Đại học Sân khấu – Điện ảnh Hà Nội tiền thân là Trường Ca kịch Dân tộc được thành lập năm 1959. Đến Ngày 17/12/1980, Hội đồng Chính phủ đã ra Quyết định số 372/CP, thành lập trường Đại học Sân khấu – Điện ảnh Hà Nội trên cơ sở sáp nhập 2 trường Trung cấp Nghệ thuật Sân khấu Việt Nam và Trường Điện ảnh Việt Nam (đều thành lập năm 1959)."@vi ;

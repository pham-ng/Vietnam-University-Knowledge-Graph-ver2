  "dbo:abstract": {
    "@language": "vi",
    "@value": "Trường Quốc gia Âm nhạc Huế là một cơ sở giáo dục chuyên về âm nhạc nhất là nhạc truyền thống Việt Nam. Trường hoạt động từ năm 1962 đến năm 1975 thì giải thể."
  },

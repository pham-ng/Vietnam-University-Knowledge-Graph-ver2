@prefix vnedu:  <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix dbo:    <http://dbpedia.org/ontology/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .

###############################################################################
#  VN-Edu Ontology 2.0 — Giáo dục đại học Việt Nam
#
#  Nguyên tắc thiết kế (để suy luận ĐÚNG và ĐẦY ĐỦ):
#   1. Nằm trong profile OWL 2 RL -> suy luận bằng luật (owlrl, Jena, GraphDB, RDFox)
#      là sound & complete, có thể "materialize" toàn bộ hệ quả.
#   2. Chỉ căn chỉnh với từ vựng ngoài bằng rdfs:subClassOf / rdfs:subPropertyOf,
#      KHÔNG dùng owl:equivalentClass sang ontology ngoài (tránh kéo theo ngữ nghĩa lạ).
#   3. KHÔNG khai báo lại domain/range cho thuộc tính của từ vựng ngoài (geo:lat, foaf:name...).
#   4. Thuộc tính tham gia property chain có range là lớp cha chung -> không sinh mâu thuẫn.
#   5. Ràng buộc "phải có" (min cardinality, kiểu dữ liệu, khoảng giá trị) đặt trong SHACL
#      (shapes/vnedu-shapes.ttl) vì OWL dùng giả định thế giới mở.
#   6. Lớp định nghĩa (defined class) để bộ suy luận tự phân loại cá thể;
#      tiên đề phân biệt (disjoint) + thuộc tính hàm (functional) để phát hiện dữ liệu sai.
###############################################################################

<https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology>
    a owl:Ontology ;
    dct:title "VN-Edu Ontology"@en , "Ontology Giáo dục đại học Việt Nam"@vi ;
    dct:description """Mô tả các cơ sở giáo dục đại học Việt Nam (đại học, trường đại học, học viện theo
Luật Giáo dục đại học 2012, sửa đổi 2018), cơ quan chủ quản, lãnh đạo, cựu sinh viên, đơn vị hành chính
(gồm cả sắp xếp tỉnh năm 2025), ngành đào tạo theo Thông tư 09/2022/TT-BGDĐT."""@vi ;
    dct:created "2026-10-05"^^xsd:date ;
    dct:modified "2026-10-06"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    owl:versionInfo "2.0" ;
    owl:versionIRI <https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology/2.0> ;
    vann:preferredNamespacePrefix "vnedu" ;
    vann:preferredNamespaceUri "https://pham-ng.github.io/Vietnam-University-Knowledge-Graph-ver2/ontology#" ;
    rdfs:comment "Profile: OWL 2 RL."@en .

###############################################################################
#  1. TỔ CHỨC
###############################################################################

vnedu:Organization a owl:Class ;
    rdfs:label "Organization"@en , "Tổ chức"@vi ;
    rdfs:subClassOf foaf:Organization , schema:Organization .

vnedu:EducationalOrganization a owl:Class ;
    rdfs:label "Educational organization"@en , "Cơ sở giáo dục"@vi ;
    rdfs:subClassOf vnedu:Organization , schema:EducationalOrganization .

vnedu:HigherEducationInstitution a owl:Class ;
    rdfs:label "Higher education institution"@en , "Cơ sở giáo dục đại học"@vi ;
    rdfs:comment "Theo Điều 4 Luật GDĐH: gồm đại học, trường đại học, học viện (và các trường sĩ quan đào tạo trình độ đại học)."@vi ;
    rdfs:subClassOf vnedu:EducationalOrganization , schema:CollegeOrUniversity .

# --- Loại hình pháp lý: xác định từ tên chính thức, đôi một rời nhau -------------

vnedu:University a owl:Class ;
    rdfs:label "University (đại học)"@en , "Đại học"@vi ;
    rdfs:comment "Cơ sở GDĐH đa ngành, có thể gồm các trường/khoa thành viên (VD: Đại học Quốc gia, Đại học Bách khoa Hà Nội)."@vi ;
    rdfs:subClassOf vnedu:HigherEducationInstitution , dbo:University .

vnedu:UniversitySchool a owl:Class ;
    rdfs:label "University-level school (trường đại học)"@en , "Trường đại học"@vi ;
    rdfs:subClassOf vnedu:HigherEducationInstitution , dbo:University .

vnedu:Academy a owl:Class ;
    rdfs:label "Academy"@en , "Học viện"@vi ;
    rdfs:subClassOf vnedu:HigherEducationInstitution .

vnedu:OfficerSchool a owl:Class ;
    rdfs:label "Officer school"@en , "Trường sĩ quan"@vi ;
    rdfs:subClassOf vnedu:HigherEducationInstitution .

[] a owl:AllDisjointClasses ;
   owl:members ( vnedu:University vnedu:UniversitySchool vnedu:Academy vnedu:OfficerSchool ) .

vnedu:NationalUniversity a owl:Class ;
    rdfs:label "National university"@en , "Đại học quốc gia"@vi ;
    rdfs:subClassOf vnedu:University .

vnedu:RegionalUniversity a owl:Class ;
    rdfs:label "Regional university"@en , "Đại học vùng"@vi ;
    rdfs:subClassOf vnedu:University ;
    owl:disjointWith vnedu:NationalUniversity .

# --- Đơn vị không phải cơ sở GDĐH độc lập ----------------------------------------

vnedu:Branch a owl:Class ;
    rdfs:label "Branch campus"@en , "Phân hiệu"@vi ;
    rdfs:comment "Đơn vị trực thuộc một cơ sở GDĐH, đặt ở địa phương khác; không phải pháp nhân độc lập."@vi ;
    rdfs:subClassOf vnedu:EducationalOrganization .

vnedu:VocationalCollege a owl:Class ;
    rdfs:label "Vocational college"@en , "Trường cao đẳng"@vi ;
    rdfs:comment "Thuộc hệ thống giáo dục nghề nghiệp, không phải cơ sở GDĐH."@vi ;
    rdfs:subClassOf vnedu:EducationalOrganization .

[] a owl:AllDisjointClasses ;
   owl:members ( vnedu:HigherEducationInstitution vnedu:Branch vnedu:VocationalCollege ) .

vnedu:GoverningBody a owl:Class ;
    rdfs:label "Governing body"@en , "Cơ quan chủ quản"@vi ;
    rdfs:comment "Cơ quan nhà nước / tổ chức chính trị quản lý trực tiếp một cơ sở giáo dục công lập."@vi ;
    rdfs:subClassOf vnedu:Organization , schema:GovernmentOrganization .

vnedu:Ministry a owl:Class ;
    rdfs:label "Ministry"@en , "Bộ / cơ quan ngang bộ"@vi ;
    rdfs:subClassOf vnedu:GoverningBody .

vnedu:ProvincialPeoplesCommittee a owl:Class ;
    rdfs:label "Provincial People's Committee"@en , "Ủy ban nhân dân cấp tỉnh"@vi ;
    rdfs:subClassOf vnedu:GoverningBody .

vnedu:Company a owl:Class ;
    rdfs:label "Company / education group"@en , "Doanh nghiệp / tập đoàn giáo dục"@vi ;
    rdfs:comment "Chủ sở hữu / nhà đầu tư của cơ sở giáo dục tư thục."@vi ;
    rdfs:subClassOf vnedu:Organization , schema:Corporation .

[] a owl:AllDisjointClasses ;
   owl:members ( vnedu:EducationalOrganization vnedu:GoverningBody vnedu:Company ) .

# --- Lớp định nghĩa: bộ suy luận tự phân loại -------------------------------------

vnedu:OwnershipType a owl:Class ;
    rdfs:label "Ownership type"@en , "Loại hình sở hữu"@vi .

vnedu:PublicOwnership a owl:NamedIndividual , vnedu:OwnershipType ;
    rdfs:label "public"@en , "công lập"@vi .
vnedu:PrivateOwnership a owl:NamedIndividual , vnedu:OwnershipType ;
    rdfs:label "private"@en , "tư thục / ngoài công lập"@vi .
[] a owl:AllDifferent ; owl:distinctMembers ( vnedu:PublicOwnership vnedu:PrivateOwnership ) .

vnedu:PublicInstitution a owl:Class ;
    rdfs:label "Public institution"@en , "Cơ sở công lập"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vnedu:EducationalOrganization
        [ a owl:Restriction ; owl:onProperty vnedu:ownership ; owl:hasValue vnedu:PublicOwnership ] ) ] .

vnedu:PrivateInstitution a owl:Class ;
    rdfs:label "Private institution"@en , "Cơ sở tư thục"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vnedu:EducationalOrganization
        [ a owl:Restriction ; owl:onProperty vnedu:ownership ; owl:hasValue vnedu:PrivateOwnership ] ) ] ;
    owl:disjointWith vnedu:PublicInstitution .

vnedu:MilitaryInstitution a owl:Class ;
    rdfs:label "Military institution"@en , "Cơ sở đào tạo quân đội"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vnedu:EducationalOrganization
        [ a owl:Restriction ; owl:onProperty vnedu:governedBy ; owl:hasValue vnedu:MinistryOfNationalDefence ] ) ] .

vnedu:PoliceInstitution a owl:Class ;
    rdfs:label "People's Public Security institution"@en , "Cơ sở đào tạo Công an nhân dân"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vnedu:EducationalOrganization
        [ a owl:Restriction ; owl:onProperty vnedu:governedBy ; owl:hasValue vnedu:MinistryOfPublicSecurity ] ) ] .

vnedu:MemberInstitution a owl:Class ;
    rdfs:label "Member institution"@en , "Trường/đơn vị thành viên"@vi ;
    rdfs:comment "Cơ sở là thành viên của một cơ sở GDĐH khác (VD: các trường thuộc ĐHQG). Suy ra từ vnedu:memberOf."@vi ;
    rdfs:subClassOf vnedu:EducationalOrganization .
# (EducationalOrganization ⊓ ∃memberOf.HigherEducationInstitution) ⊑ MemberInstitution — dạng hợp lệ trong OWL 2 RL
[ a owl:Class ; owl:intersectionOf ( vnedu:EducationalOrganization
    [ a owl:Restriction ; owl:onProperty vnedu:memberOf ; owl:someValuesFrom vnedu:HigherEducationInstitution ] ) ]
    rdfs:subClassOf vnedu:MemberInstitution .

vnedu:DefunctInstitution a owl:Class ;
    rdfs:label "Defunct institution"@en , "Cơ sở đã giải thể / sáp nhập"@vi ;
    rdfs:subClassOf vnedu:EducationalOrganization .
[ a owl:Class ; owl:intersectionOf ( vnedu:EducationalOrganization
    [ a owl:Restriction ; owl:onProperty vnedu:dissolutionYear ; owl:someValuesFrom xsd:gYear ] ) ]
    rdfs:subClassOf vnedu:DefunctInstitution .

# Cá thể tham chiếu dùng trong lớp định nghĩa (thông tin chi tiết nằm trong dữ liệu)
vnedu:MinistryOfNationalDefence a owl:NamedIndividual , vnedu:Ministry ;
    rdfs:label "Bộ Quốc phòng"@vi , "Ministry of National Defence"@en .
vnedu:MinistryOfPublicSecurity a owl:NamedIndividual , vnedu:Ministry ;
    rdfs:label "Bộ Công an"@vi , "Ministry of Public Security"@en .

###############################################################################
#  2. CON NGƯỜI
###############################################################################

vnedu:Person a owl:Class ;
    rdfs:label "Person"@en , "Người"@vi ;
    rdfs:subClassOf foaf:Person , schema:Person .

vnedu:Alumnus a owl:Class ;
    rdfs:label "Alumnus"@en , "Cựu sinh viên"@vi ;
    rdfs:subClassOf vnedu:Person .
[ a owl:Class ; owl:intersectionOf ( vnedu:Person
    [ a owl:Restriction ; owl:onProperty vnedu:alumnusOf ; owl:someValuesFrom vnedu:EducationalOrganization ] ) ]
    rdfs:subClassOf vnedu:Alumnus .

vnedu:InstitutionLeader a owl:Class ;
    rdfs:label "Institution leader"@en , "Người đứng đầu cơ sở giáo dục"@vi ;
    rdfs:subClassOf vnedu:Person .
[ a owl:Class ; owl:intersectionOf ( vnedu:Person
    [ a owl:Restriction ; owl:onProperty vnedu:leads ; owl:someValuesFrom vnedu:EducationalOrganization ] ) ]
    rdfs:subClassOf vnedu:InstitutionLeader .

###############################################################################
#  3. ĐỊA LÝ HÀNH CHÍNH
###############################################################################

vnedu:AdministrativeUnit a owl:Class ;
    rdfs:label "Administrative unit"@en , "Đơn vị hành chính / vùng"@vi ;
    rdfs:subClassOf schema:AdministrativeArea .

vnedu:Country a owl:Class ;
    rdfs:label "Country"@en , "Quốc gia"@vi ;
    rdfs:subClassOf vnedu:AdministrativeUnit , schema:Country .

vnedu:Region a owl:Class ;
    rdfs:label "Region"@en , "Miền"@vi ;
    rdfs:comment "Ba miền Bắc Bộ, Trung Bộ, Nam Bộ."@vi ;
    rdfs:subClassOf vnedu:AdministrativeUnit .

vnedu:Province a owl:Class ;
    rdfs:label "Province-level unit (current)"@en , "Tỉnh / thành phố (hiện hành)"@vi ;
    rdfs:comment "34 đơn vị hành chính cấp tỉnh từ 01/07/2025 (Nghị quyết 202/2025/QH15)."@vi ;
    rdfs:subClassOf vnedu:AdministrativeUnit .

vnedu:CentrallyGovernedCity a owl:Class ;
    rdfs:label "Centrally-governed city"@en , "Thành phố trực thuộc trung ương"@vi ;
    rdfs:subClassOf vnedu:Province .

vnedu:FormerProvince a owl:Class ;
    rdfs:label "Former province"@en , "Tỉnh cũ (trước 01/07/2025)"@vi ;
    rdfs:subClassOf vnedu:AdministrativeUnit .

[] a owl:AllDisjointClasses ;
   owl:members ( vnedu:Country vnedu:Region vnedu:Province vnedu:FormerProvince ) .

[] a owl:AllDisjointClasses ;
   owl:members ( vnedu:Organization vnedu:Person vnedu:AdministrativeUnit ) .

###############################################################################
#  4. NGÀNH ĐÀO TẠO
###############################################################################

vnedu:FieldOfStudy a owl:Class ;
    rdfs:label "Field of study"@en , "Lĩnh vực đào tạo"@vi ;
    rdfs:subClassOf skos:Concept .

vnedu:Major a owl:Class ;
    rdfs:label "Major"@en , "Ngành đào tạo"@vi ;
    rdfs:subClassOf skos:Concept ;
    owl:disjointWith vnedu:FieldOfStudy .

vnedu:AcademicProgram a owl:Class ;
    rdfs:label "Academic program"@en , "Chương trình đào tạo"@vi ;
    rdfs:subClassOf schema:EducationalOccupationalProgram .

###############################################################################
#  5. THUỘC TÍNH QUAN HỆ
###############################################################################

# --- Địa lý: partOf bắc cầu + 2 chuỗi thuộc tính --------------------------------

vnedu:partOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "part of"@en , "thuộc (đơn vị lớn hơn)"@vi ;
    rdfs:domain vnedu:AdministrativeUnit ;
    rdfs:range vnedu:AdministrativeUnit ;
    owl:inverseOf vnedu:hasPart .

vnedu:hasPart a owl:ObjectProperty ;
    rdfs:label "has part"@en , "gồm"@vi .

vnedu:mergedInto a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "merged into"@en , "sáp nhập vào"@vi ;
    rdfs:domain vnedu:FormerProvince ;
    rdfs:range vnedu:Province ;
    owl:inverseOf vnedu:mergedFrom .

vnedu:mergedFrom a owl:ObjectProperty ;
    rdfs:label "merged from"@en , "hình thành từ"@vi .

vnedu:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in"@en , "đặt tại"@vi ;
    rdfs:comment "Suy luận: đặt tại tỉnh => đặt tại miền và quốc gia; đặt tại tỉnh cũ => đặt tại tỉnh mới."@vi ;
    rdfs:domain vnedu:Organization ;
    rdfs:range vnedu:AdministrativeUnit ;
    rdfs:subPropertyOf schema:location .

# locatedIn ∘ partOf ⊑ locatedIn      (Trường ở Hà Nội, Hà Nội ⊂ Bắc Bộ  => Trường ở Bắc Bộ)
vnedu:locatedIn owl:propertyChainAxiom ( vnedu:locatedIn vnedu:partOf ) .
# locatedIn ∘ mergedInto ⊑ locatedIn  (Trường ở Bình Dương (cũ) => Trường ở TP. Hồ Chí Minh)
vnedu:locatedIn owl:propertyChainAxiom ( vnedu:locatedIn vnedu:mergedInto ) .

# --- Tổ chức -----------------------------------------------------------------------

vnedu:memberOf a owl:ObjectProperty ;
    rdfs:label "member of"@en , "là thành viên của"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:HigherEducationInstitution ;
    rdfs:subPropertyOf schema:parentOrganization ;
    owl:inverseOf vnedu:hasMember .

vnedu:hasMember a owl:ObjectProperty ;
    rdfs:label "has member"@en , "có đơn vị thành viên"@vi ;
    rdfs:subPropertyOf schema:subOrganization .

vnedu:branchOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "branch of"@en , "là phân hiệu của"@vi ;
    rdfs:domain vnedu:Branch ;
    rdfs:range vnedu:HigherEducationInstitution ;
    owl:inverseOf vnedu:hasBranch .

vnedu:hasBranch a owl:ObjectProperty ;
    rdfs:label "has branch"@en , "có phân hiệu"@vi .

vnedu:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by"@en , "có cơ quan chủ quản"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:GoverningBody ;
    owl:inverseOf vnedu:governs .

vnedu:governs a owl:ObjectProperty ;
    rdfs:label "governs"@en , "là cơ quan chủ quản của"@vi .

vnedu:subordinateTo a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "subordinate to"@en , "trực thuộc (cơ quan cấp trên)"@vi ;
    rdfs:domain vnedu:GoverningBody ;
    rdfs:range vnedu:GoverningBody .

# governedBy ∘ subordinateTo ⊑ governedBy
# (Trường thuộc Quân chủng Hải quân, Quân chủng Hải quân thuộc Bộ Quốc phòng => trường thuộc Bộ Quốc phòng
#  => được phân loại là MilitaryInstitution)
vnedu:governedBy owl:propertyChainAxiom ( vnedu:governedBy vnedu:subordinateTo ) .

vnedu:ownedBy a owl:ObjectProperty ;
    rdfs:label "owned by"@en , "thuộc sở hữu / đầu tư của"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:Company ;
    rdfs:subPropertyOf schema:parentOrganization .

vnedu:ownership a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "ownership"@en , "loại hình sở hữu"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:OwnershipType .

# Cơ sở có chủ sở hữu là doanh nghiệp  => tư thục   (∃ownedBy.Company ⊑ ownership value Private)
[ a owl:Restriction ; owl:onProperty vnedu:ownedBy ; owl:someValuesFrom vnedu:Company ]
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty vnedu:ownership ; owl:hasValue vnedu:PrivateOwnership ] .

# --- Con người ---------------------------------------------------------------------

vnedu:leads a owl:ObjectProperty ;
    rdfs:label "leads"@en , "đứng đầu"@vi ;
    rdfs:domain vnedu:Person ;
    rdfs:range vnedu:Organization ;
    owl:inverseOf vnedu:hasLeader .

vnedu:hasLeader a owl:ObjectProperty ;
    rdfs:label "has leader"@en , "có người đứng đầu"@vi ;
    rdfs:subPropertyOf schema:employee .

vnedu:rector a owl:ObjectProperty ;
    rdfs:label "rector"@en , "hiệu trưởng"@vi ;
    rdfs:subPropertyOf vnedu:hasLeader .

vnedu:director a owl:ObjectProperty ;
    rdfs:label "director / president"@en , "giám đốc"@vi ;
    rdfs:subPropertyOf vnedu:hasLeader .

vnedu:councilChair a owl:ObjectProperty ;
    rdfs:label "chair of the university council"@en , "chủ tịch hội đồng trường"@vi ;
    rdfs:comment "Chủ tịch hội đồng trường (Luật GDĐH 2018, Điều 16) — vai trò quản trị, tách khỏi hiệu trưởng/giám đốc."@vi ;
    rdfs:subPropertyOf vnedu:hasLeader .

vnedu:alumnusOf a owl:ObjectProperty ;
    rdfs:label "alumnus of"@en , "cựu sinh viên của"@vi ;
    rdfs:domain vnedu:Person ;
    rdfs:range vnedu:EducationalOrganization ;
    rdfs:subPropertyOf schema:alumniOf ;
    owl:inverseOf vnedu:hasAlumnus .

vnedu:hasAlumnus a owl:ObjectProperty ;
    rdfs:label "has alumnus"@en , "có cựu sinh viên"@vi .

# --- Ngành đào tạo -----------------------------------------------------------------

vnedu:offersProgram a owl:ObjectProperty ;
    rdfs:label "offers program"@en , "đào tạo chương trình"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range vnedu:AcademicProgram ;
    owl:inverseOf vnedu:offeredBy .

vnedu:offeredBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "offered by"@en , "do ... đào tạo"@vi ;
    rdfs:subPropertyOf schema:provider .

vnedu:ofMajor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "of major"@en , "thuộc ngành"@vi ;
    rdfs:domain vnedu:AcademicProgram ;
    rdfs:range vnedu:Major .

vnedu:inField a owl:ObjectProperty ;
    rdfs:label "in field"@en , "thuộc lĩnh vực"@vi ;
    rdfs:domain vnedu:Major ;
    rdfs:range vnedu:FieldOfStudy ;
    rdfs:subPropertyOf skos:broader .

# offersProgram ∘ ofMajor ⊑ trainsMajor   (trường đào tạo ngành X — suy ra từ chương trình)
vnedu:trainsMajor a owl:ObjectProperty ;
    rdfs:label "trains major"@en , "đào tạo ngành"@vi ;
    owl:propertyChainAxiom ( vnedu:offersProgram vnedu:ofMajor ) .

vnedu:website a owl:ObjectProperty ;
    rdfs:label "website"@en , "trang web"@vi ;
    rdfs:subPropertyOf foaf:homepage .

###############################################################################
#  6. THUỘC TÍNH DỮ LIỆU
###############################################################################

vnedu:foundingYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "founding year"@en , "năm thành lập"@vi ;
    rdfs:domain vnedu:Organization ;
    rdfs:range xsd:gYear .

vnedu:dissolutionYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "dissolution year"@en , "năm giải thể / sáp nhập"@vi ;
    rdfs:domain vnedu:Organization ;
    rdfs:range xsd:gYear .

vnedu:admissionCode a owl:DatatypeProperty ;
    rdfs:label "admission code"@en , "mã trường (tuyển sinh)"@vi ;
    rdfs:comment "Mã trường dùng trong tuyển sinh đại học của Bộ GD&ĐT (VD: BKA, KHA, NTH)."@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf skos:notation .

vnedu:shortName a owl:DatatypeProperty ;
    rdfs:label "short name"@en , "tên viết tắt"@vi ;
    rdfs:range xsd:string .

vnedu:formerName a owl:DatatypeProperty ;
    rdfs:label "former name"@en , "tên cũ"@vi ;
    rdfs:range rdf:langString .

vnedu:motto a owl:DatatypeProperty ;
    rdfs:label "motto"@en , "khẩu hiệu"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range rdf:langString .

vnedu:history a owl:DatatypeProperty ;
    rdfs:label "history"@en , "lịch sử hình thành"@vi ;
    rdfs:comment "Tóm tắt mục Lịch sử của bài Wikipedia tiếng Việt (CC BY-SA 4.0); bản sửa đổi gốc ghi ở prov:wasDerivedFrom."@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range rdf:langString .

vnedu:campus a owl:DatatypeProperty ;
    rdfs:label "campus"@en , "khuôn viên"@vi ;
    rdfs:comment "Diện tích / mô tả khuôn viên đúng như ghi ở nguồn (đơn vị không thống nhất nên giữ dạng văn bản)."@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range xsd:string .

vnedu:funding a owl:DatatypeProperty ;
    rdfs:label "funding / endowment"@en , "tài trợ, ngân sách, vốn đầu tư"@vi ;
    rdfs:comment "Giá trị đúng như ghi ở nguồn (kèm đơn vị tiền tệ, có thể kèm năm)."@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range xsd:string .

vnedu:address a owl:DatatypeProperty ;
    rdfs:label "address"@en , "địa chỉ"@vi ;
    rdfs:range xsd:string .

vnedu:numberOfStudents a owl:DatatypeProperty ;
    rdfs:label "number of students"@en , "số sinh viên"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range xsd:nonNegativeInteger .

vnedu:numberOfUndergraduates a owl:DatatypeProperty ;
    rdfs:label "number of undergraduate students"@en , "số sinh viên đại học"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range xsd:nonNegativeInteger .

vnedu:numberOfPostgraduates a owl:DatatypeProperty ;
    rdfs:label "number of postgraduate students"@en , "số học viên sau đại học"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range xsd:nonNegativeInteger .

vnedu:academicStaff a owl:DatatypeProperty ;
    rdfs:label "academic staff"@en , "số giảng viên"@vi ;
    rdfs:domain vnedu:EducationalOrganization ;
    rdfs:range xsd:nonNegativeInteger .

vnedu:code a owl:DatatypeProperty ;
    rdfs:label "code"@en , "mã ngành / mã lĩnh vực"@vi ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf skos:notation .

vnedu:degreeLevel a owl:DatatypeProperty ;
    rdfs:label "degree level"@en , "trình độ đào tạo"@vi ;
    rdfs:domain vnedu:AcademicProgram .

vnedu:population a owl:DatatypeProperty ;
    rdfs:label "population"@en , "dân số"@vi ;
    rdfs:domain vnedu:AdministrativeUnit ;
    rdfs:range xsd:nonNegativeInteger .

vnedu:area a owl:DatatypeProperty ;
    rdfs:label "area (km²)"@en , "diện tích (km²)"@vi ;
    rdfs:domain vnedu:AdministrativeUnit ;
    rdfs:range xsd:decimal .

vnedu:birthDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "birth date"@en , "ngày sinh"@vi ;
    rdfs:domain vnedu:Person ;
    rdfs:range xsd:date .

vnedu:honorific a owl:DatatypeProperty ;
    rdfs:label "academic title / rank"@en , "học hàm, học vị, quân hàm"@vi ;
    rdfs:domain vnedu:Person ;
    rdfs:range xsd:string .

###############################################################################
#  7. TÁI SỬ DỤNG thay vì tạo mới
#  - Thuộc tính: dùng thẳng schema:hasOccupation, schema:gender (không đặt vnedu:occupation/gender).
#  - Giá trị: dùng thẳng URI Wikidata của nghề nghiệp / giới tính (wd:Q82955 "politician",
#    wd:Q6581097 "male"...) — ta không có gì để mô tả thêm về chúng nên KHÔNG tạo URI riêng.
#  - Thực thể ta mô tả bằng dữ kiện riêng (cơ sở, tỉnh, người, cơ quan...) thì có URI riêng
#    + owl:sameAs sang Wikidata / DBpedia / ROR / GeoNames (xem docs/uri-strategy.md).
#  Chỉ khai báo loại thuộc tính (không đặt lại domain/range của từ vựng ngoài).
###############################################################################

schema:hasOccupation a owl:ObjectProperty ;
    rdfs:label "has occupation"@en , "nghề nghiệp"@vi ;
    rdfs:comment "Tái sử dụng từ schema.org; giá trị là item Wikidata về nghề nghiệp."@vi .

schema:gender a owl:ObjectProperty ;
    rdfs:label "gender"@en , "giới tính"@vi ;
    rdfs:comment "Tái sử dụng từ schema.org; giá trị là item Wikidata (Q6581097 nam, Q6581072 nữ)."@vi .

# --- Thông tin giới thiệu, ảnh, liên hệ: dùng thẳng từ vựng DBpedia / SKOS / schema.org --------
dbo:abstract a owl:DatatypeProperty ;
    rdfs:label "abstract"@en , "giới thiệu chung"@vi ;
    rdfs:comment "Đoạn mở đầu bài Wikipedia tiếng Việt (CC BY-SA 4.0) — cùng thuộc tính DBpedia dùng cho tóm tắt."@vi .

dbo:affiliation a owl:ObjectProperty ;
    rdfs:label "affiliation"@en , "liên kết, đối tác"@vi ;
    rdfs:comment "Đối tác / liên kết học thuật. Đích là URI Wikidata của tổ chức đối tác (tái sử dụng, không tạo URI mới)."@vi .

skos:altLabel a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en , "tên khác"@vi .

schema:foundingDate a owl:DatatypeProperty ;
    rdfs:label "founding date"@en , "ngày thành lập"@vi ;
    rdfs:comment "Ngày thành lập ghi trong infobox. vnedu:foundingYear là năm sớm nhất giữa các nguồn (có thể tính từ tiền thân hoặc ngày phê duyệt chủ trương) nên có thể sớm hơn."@vi .

schema:telephone a owl:DatatypeProperty ; rdfs:label "telephone"@en , "điện thoại"@vi .
schema:email a owl:DatatypeProperty ; rdfs:label "email"@en , "thư điện tử"@vi .

schema:logo a owl:ObjectProperty ; rdfs:label "logo"@en , "biểu trưng"@vi .
schema:image a owl:ObjectProperty ; rdfs:label "image"@en , "hình ảnh"@vi .
schema:ImageObject a owl:Class ; rdfs:label "image object"@en , "tệp ảnh"@vi .
schema:thumbnailUrl a owl:ObjectProperty ; rdfs:label "thumbnail"@en , "ảnh thu nhỏ"@vi .
schema:mainEntityOfPage a owl:ObjectProperty ; rdfs:label "description page"@en , "trang mô tả tệp"@vi .
schema:license a owl:DatatypeProperty ; rdfs:label "license"@en , "giấy phép"@vi .
schema:creditText a owl:DatatypeProperty ; rdfs:label "credit"@en , "tác giả / ghi công"@vi .

    vnedu:address "Số 373, phố Lý Bôn, phường Trần Lãm" ;
    vnedu:admissionCode "YTB" ;
    vnedu:councilChair person:nguyen-quoc-tien ;
    vnedu:formerName "Trường Đại học Y Thái Bình"@vi ;
    vnedu:foundingYear "1968"^^xsd:gYear ;

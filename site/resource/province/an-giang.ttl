province:an-giang a vnedu:AdministrativeUnit,
        vnedu:Province,
        schema:AdministrativeArea ;
    rdfs:label "An Giang"@en,
        "An Giang"@vi ;
    owl:sameAs dbr:An_Giang_province,
        wd:Q36592,
        <https://sws.geonames.org/1594446/> ;
    geo:lat 10.5 ;
    geo:long 105.166666666 ;
    prov:wasDerivedFrom wd:Q36592 ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/An_Giang_province>,
        <https://vi.wikipedia.org/wiki/An_Giang> ;
    vnedu:area 9889.0 ;
    vnedu:mergedFrom province:kien-giang ;
    vnedu:partOf country:viet-nam,
        region:nam-bo ;
    vnedu:population "3679300"^^xsd:nonNegativeInteger .

